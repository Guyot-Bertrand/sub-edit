#!/usr/bin/env bash
# Quick checks before each commit.
#
# Quick is a design criterion: a slow hook ends up bypassed with --no-verify,
# and a bypassed hook protects nothing.

set -euo pipefail

# shellcheck source=src/scripts/lib/output.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/output.sh"

fail() { printf '%spre-commit: %s%s\n' "${RED}" "$*" "${RESET}" >&2; exit 1; }

staged_files() { git diff --cached --name-only --diff-filter=ACMR; }

# 1. The reference repository never enters a commit.
check_reference_not_staged() {
    local staged
    staged="$(staged_files | grep '^reference/' || true)"
    [[ -z "${staged}" ]] || fail "the reference repository is staged, it must never be committed:
$(printf '  %s\n' ${staged})
  unstage it with: git restore --staged reference/"
}

# 2. The staged code respects the format.
check_format() {
    local sources
    sources="$(staged_files | grep -E '\.(cpp|hpp|cc|h)$' || true)"
    [[ -n "${sources}" ]] || return 0

    if ! command -v clang-format >/dev/null 2>&1; then
        printf 'pre-commit: clang-format missing, format check skipped\n' >&2
        printf '            install it with: ./src/scripts/setup-toolchain.sh\n' >&2
        return 0
    fi

    local unformatted=()
    local file
    while IFS= read -r file; do
        [[ -f "${file}" ]] || continue
        if ! clang-format --dry-run --Werror "${file}" >/dev/null 2>&1; then
            unformatted+=("${file}")
        fi
    done <<< "${sources}"

    (( ${#unformatted[@]} == 0 )) || fail "unformatted files:
$(printf '  %s\n' "${unformatted[@]}")
  fix them with: make format"
}

check_reference_not_staged
check_format
