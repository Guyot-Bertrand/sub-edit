[
  {"name": "a faithful translation passes"},
  {"name": "an image shown from the source tree is the same image",
   "edit": {"file": "index.md", "old": "](captures/picture.png)", "new": "](../../../manual/captures/picture.png)"}},
  {"name": "a source page without translation",
   "edit": {"delete": "sub/page.md"},
   "expect": {"kind": "MISSING PAGE", "page": "sub/page.md", "line": 0}},
  {"name": "a translated page without source",
   "edit": {"create": "extra.md", "text": "# Extra\n"},
   "expect": {"kind": "EXTRA PAGE", "page": "extra.md", "line": 0}},
  {"name": "a heading one level deeper",
   "edit": {"file": "sub/page.md", "old": "## Opciones", "new": "### Opciones"},
   "expect": {"kind": "HEADINGS", "page": "sub/page.md", "line": 5}},
  {"name": "a heading added",
   "edit": {"file": "index.md", "old": "## Contenido", "new": "## Contenido\n\n## Otro"},
   "expect": {"kind": "HEADINGS", "page": "index.md", "line": 7}},
  {"name": "a table row lost",
   "edit": {"file": "sub/page.md", "old": "| `--to` | ninguno | auto |\n", "new": ""},
   "expect": {"kind": "TABLE", "page": "sub/page.md", "line": 7}},
  {"name": "a table cell with a column fewer",
   "edit": {"file": "sub/page.md", "old": "| `--to` | ninguno | auto |", "new": "| `--to` | ninguno |"},
   "expect": {"kind": "TABLE", "page": "sub/page.md", "line": 7}},
  {"name": "a shortcut changed in a table cell",
   "edit": {"file": "sub/page.md", "old": "`Ctrl+B`", "new": "`Ctrl+N`"},
   "expect": {"kind": "TABLE", "page": "sub/page.md", "line": 7}},
  {"name": "a code block that is not the source's",
   "edit": {"file": "sub/page.md", "old": "\ndone\n", "new": "\nhecho\n"},
   "expect": {"kind": "CODE BLOCK", "page": "sub/page.md", "line": 12}},
  {"name": "a code block language tag changed",
   "edit": {"file": "sub/page.md", "old": "```console", "new": "```text"},
   "expect": {"kind": "CODE BLOCK", "page": "sub/page.md", "line": 12}},
  {"name": "a link to another page",
   "edit": {"file": "sub/page.md", "old": "(../index.md)", "new": "(../otra.md)"},
   "expect": {"kind": "LINK", "page": "sub/page.md", "line": 17}},
  {"name": "a link dropped",
   "edit": {"file": "index.md", "old": "las [notas compartidas](../../../shared.md)", "new": "las notas compartidas"},
   "expect": {"kind": "LINK", "page": "index.md", "line": 1}},
  {"name": "an image changed",
   "edit": {"file": "index.md", "old": "captures/picture.png", "new": "captures/other.png"},
   "expect": {"kind": "IMAGE", "page": "index.md", "line": 11}},
  {"name": "an identifier translated in running text",
   "edit": {"file": "sub/page.md", "old": "`tool --by 5` para", "new": "`herramienta --by 5` para"},
   "expect": {"kind": "CODE SPAN", "page": "sub/page.md", "line": 3}},
  {"name": "a list item lost",
   "edit": {"file": "index.md", "old": "- un tercer elemento\n", "new": ""},
   "expect": {"kind": "LIST ITEMS", "page": "index.md", "line": 8}}
]
