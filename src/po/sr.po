#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Поставке програма subedit.\n"
"#\n"
"# Опције које су на подразумеваној вредности записане су као коментар.\n"
"# Уклоните коментар са реда и промените му вредност да бисте је\n"
"# преписали; обришите ред да бисте се вратили на подразумевану\n"
"# вредност, ма каква она постала у каснијем издању.\n"
"#\n"
"# Две од њих подразумевано су оно што изабере прозор, а не неки\n"
"# број: њихов коментарисани ред показује облик вредности, а не\n"
"# подразумевану вредност која је на снази.\n"
"#\n"
"# Вредност коју ова датотека не може да прочита остаје на\n"
"# подразумеваној и то се пише на стандардни ток грешака при\n"
"# покретању програма.\n"

#: src/lib/subedit/core/wording/settings.cpp
msgid "cannot be read, keeping the default"
msgstr "не може се прочитати, задржава се подразумевана вредност"

#: src/lib/subedit/core/wording/settings.cpp
msgid "settings could not be written"
msgstr "поставке се нису могле записати"

