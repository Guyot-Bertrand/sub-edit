msgid "Do not let the reading speed bring an end earlier"
msgstr "Не дозвољавај да брзина читања помери крај раније"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Нека брзина читања помери крај касније"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "Не дозвољавај да брзина читања помери крај касније"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "Најкраће трајање, или off (подразумевано 1.5)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "Најдуже трајање, или off (подразумевано: без ограничења)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr ""
"Најмање преосталог времена до следећег титла, или off (подразумевано 0)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Спојите титл датотеке једну за другом у једну датотеку"

#: src/exe/cli/commands/append.cpp
msgid "The base file, then the files to put after it, in order"
msgstr "Основна датотека, затим датотеке које се додају после ње, редом"

#: src/exe/cli/commands/append.cpp
msgid "File to write"
msgstr "Датотека за писање"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/command.cpp
#: src/exe/cli/commands/split_file.cpp
