msgid "%1 subtitle transformed onto %2 and %3"
msgid_plural "%1 subtitles transformed onto %2 and %3"
msgstr[0] "Титлова преображених на %2 и %3: %1"
msgstr[1] "Титлова преображених на %2 и %3: %1"
msgstr[2] "Титлова преображених на %2 и %3: %1"

