#~ msgid ""
#~ "%1 of the %2 pieces are only notes in brackets, such as [MUSIC PLAYING]: "
#~ "the language used (%3) is probably not the one spoken, and the engine may "
#~ "have translated the speech. Run it again with the language typed."
#~ msgstr ""
#~ "%1 z %2 částí jsou jen poznámky v hranatých závorkách, například [MUSIC "
#~ "PLAYING]: použitý jazyk (%3) pravděpodobně není ten, kterým se mluví, a "
#~ "nástroj mohl řeč přeložit. Spusťte přepis znovu se zadaným jazykem."

#~ msgid ""
#~ "A language code such as fr, en, de, es or it (fra and eng work too). "
#~ "Leave it empty to let the model detect the language from the first 30 "
#~ "seconds of sound."
#~ msgstr ""
#~ "Kód jazyka, například fr, en, de, es nebo it (fungují i fra a eng). "
#~ "Nechte pole prázdné, aby model zjistil jazyk z prvních 30 sekund zvuku."

#~ msgid "estimating the time left…"
#~ msgstr "odhaduje se zbývající čas…"

#~ msgid "This model cannot detect the language: type it."
#~ msgstr "Tento model neumí zjistit jazyk: zadejte ho."

#~ msgid ""
#~ "The file declares no language for this track: the model will detect it "
#~ "from the sound. Type it if you know it."
#~ msgstr ""
#~ "Soubor pro tuto stopu neuvádí žádný jazyk: model ho zjistí ze zvuku. "
#~ "Pokud ho znáte, zadejte ho."

#~ msgid "Beginning"
#~ msgstr "Začátek"

#~ msgid "Detected"
#~ msgstr "Zjištěný"

#~ msgid ""
#~ "The model file the engine reads. It is not shipped with the program: the "
#~ "manual says where to find one."
#~ msgstr ""
#~ "Soubor modelu, který nástroj čte. S programem se nedodává: příručka říká, "
#~ "kde ho získat."
