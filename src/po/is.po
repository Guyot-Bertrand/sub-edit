#: src/exe/cli/application.cpp
msgid "Display program version information and exit"
msgstr "Birta útgáfuupplýsingar forritsins og hætta"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr ""
"Segja meira: -v er sjálfgefið, -vv gefur nánari upplýsingar, -vvv aflúsar"

#: src/exe/cli/application.cpp
msgid "Say nothing but errors"
msgstr "Segja ekkert nema villur"

#: src/exe/cli/application.cpp
msgid "Encoding to read the files in; detected by default"
msgstr ""
"Stafakóðun sem skrárnar eru lesnar í; sjálfgefið er hún greind sjálfkrafa"

