msgstr "%1: „%2“ er ekki tímalengd upp á núll eða meira"

#: src/lib/subedit/cli/adjusting.cpp
msgid "%1: \"%2\" is not a duration above zero"
msgstr "%1: „%2“ er ekki tímalengd yfir núlli"

