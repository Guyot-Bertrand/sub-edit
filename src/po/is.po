msgstr "%1 (þurrkeyrsla, ekkert skrifað)"

#: src/lib/subedit/cli/appending.cpp
msgid "%1 -> %2"
msgstr "%1 -> %2"

#. TRANSLATORS: %1 of %2 files were done; the form is chosen by %2.
#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file adjusted"
msgid_plural "%1 of %2 files adjusted"
msgstr[0] "Skrá aðlöguð: %1 af %2"
msgstr[1] "Skrár aðlagaðar: %1 af %2"

#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file aligned"
msgid_plural "%1 of %2 files aligned"
msgstr[0] "Skrá jöfnuð: %1 af %2"
msgstr[1] "Skrár jafnaðar: %1 af %2"

#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file changed"
msgid_plural "%1 of %2 files changed"
