msgid "Form of the result on standard output: text or json"
msgstr "Form niðurstöðunnar á staðalúttaki: text eða json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr "Lesa stillingar aðgerða úr FILE í stað stillingaskrár notandans"

#: src/exe/cli/application.cpp
msgid "Ignore any settings file: use the built-in defaults"
msgstr "Hunsa allar stillingaskrár: nota innbyggð sjálfgildi"

#: src/exe/cli/application.cpp
msgid "Write the encodings that can be read and written, one a line, and stop"
msgstr ""
"Skrifa stafakóðanirnar sem hægt er að lesa og skrifa, eina í hverri línu, og "
"hætta"

#: src/exe/cli/application.cpp
msgid "--config needs a file name"
msgstr "--config krefst skráarheitis"

#: src/exe/cli/commands/adjust.cpp
msgid "Bring the duration of every subtitle within a reading speed and limits"
msgstr "Aðlaga tímalengd hvers skjátexta að lestrarhraða og mörkum"

#: src/exe/cli/commands/adjust.cpp
msgid "Subtitle files to adjust"
msgstr "Skjátextaskrár til að aðlaga"

#: src/exe/cli/commands/adjust.cpp
msgid "Reading speed in characters per second, or off (default 15)"
msgstr "Lestrarhraði í stöfum á sekúndu, eða off (sjálfgefið 15)"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed bring an end earlier"
msgstr "Láta lestrarhraðann færa endi fyrr"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed bring an end earlier"
msgstr "Ekki láta lestrarhraðann færa endi fyrr"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Láta lestrarhraðann færa endi síðar"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "Ekki láta lestrarhraðann færa endi síðar"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "Stysta tímalengd, eða off (sjálfgefið 1.5)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "Lengsta tímalengd, eða off (sjálfgefið: engin)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr "Minnsti tími sem er eftir að næsta skjátexta, eða off (sjálfgefið 0)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Setja skjátextaskrár hverja á eftir annarri í eina skrá"

#: src/exe/cli/commands/append.cpp
msgid "The base file, then the files to put after it, in order"
msgstr "Grunnskráin og svo skrárnar sem fara á eftir henni, í réttri röð"

#: src/exe/cli/commands/append.cpp
msgid "File to write"
msgstr "Skrá til að skrifa"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/command.cpp
#: src/exe/cli/commands/split_file.cpp
msgid "Work out and say what would be written, and write nothing"
msgstr "Reikna út og segja hvað yrði skrifað, án þess að skrifa neitt"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid "Put the subtitles in order of their start before writing"
msgstr "Raða skjátextunum eftir upphafi áður en skrifað er"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before writing"
msgstr ""
"Stytta skjátexta sem skarast þannig að ekkert tímabil skarist við annað, "
"áður en skrifað er"

#: src/exe/cli/commands/append.cpp
msgid "append needs a base file and at least one file to put after it"
msgstr ""
"append krefst grunnskrár og að minnsta kosti einnar skrár til að setja á "
"eftir henni"

#: src/exe/cli/commands/append.cpp
msgid "no destination given: append writes one file, use --output"
msgstr "enginn áfangastaður gefinn: append skrifar eina skrá, notaðu --output"

#: src/exe/cli/commands/command.cpp
msgid "File to write, for a single input"
msgstr "Skrá til að skrifa, fyrir eina inntaksskrá"

#: src/exe/cli/commands/command.cpp
msgid "Directory to write into"
msgstr "Mappa til að skrifa í"

#: src/exe/cli/commands/command.cpp
msgid "Write back over the inputs"
msgstr "Skrifa yfir inntaksskrárnar"

#: src/exe/cli/commands/command.cpp
msgid "Take directories as inputs, and every subtitle file in them"
msgstr "Taka möppur sem inntak, og allar skjátextaskrár í þeim"

#: src/exe/cli/commands/command.cpp
msgid "Act only on subtitles N to M, or N to the end"
msgstr "Aðgerð nær aðeins til skjátexta N til M, eða N til enda"

#: src/exe/cli/commands/command.cpp
msgid "Translation file to lay over the subtitle file, for a single input"
msgstr ""
"Þýðingarskrá til að leggja yfir skjátextaskrána, fyrir eina inntaksskrá"

#: src/exe/cli/commands/command.cpp
msgid "How the lines of the translation find their subtitles"
msgstr "Hvernig línur þýðingarinnar finna skjátexta sína"

#: src/exe/cli/commands/command.cpp
msgid "The document to change: the main one, or the translation given by -t"
msgstr "Skjalið sem á að breyta: aðalskjalið, eða þýðingin sem gefin er með -t"

#: src/exe/cli/commands/config.cpp
msgid "List, show and change the operation settings"
msgstr "Telja upp, sýna og breyta stillingum aðgerða"

#: src/exe/cli/commands/config.cpp
msgid ""
"Write every operation key, what it is for, what it accepts and its default"
msgstr ""
"Skrifa alla lykla aðgerða, til hvers þeir eru, hvað þeir taka við og "
"sjálfgildi þeirra"

