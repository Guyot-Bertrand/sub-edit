msgstr "Skrifa KEY = VALUE í stillingaskrána og halda öllum öðrum stillingum"

#: src/exe/cli/commands/config.cpp
msgid "Operation key, as config list names it"
msgstr "Lykill aðgerðar, eins og config list nefnir hann"

#: src/exe/cli/commands/config.cpp
msgid "Value, as config list says it accepts"
msgstr "Gildi, eins og config list segir að það sé tekið við"

#: src/exe/cli/commands/config.cpp
msgid ""
"Put KEY back to its default in the settings file, keeping every other setting"
msgstr ""
"Setja KEY aftur á sjálfgildi sitt í stillingaskránni og halda öllum öðrum "
"stillingum"

#: src/exe/cli/commands/config.cpp
msgid "--no-config has nothing to write to"
msgstr "--no-config hefur ekkert til að skrifa í"

#: src/exe/cli/commands/config.cpp
msgid "no settings file could be located; give one with --config FILE"
msgstr "ekki tókst að finna stillingaskrá; gefðu eina með --config FILE"

#: src/exe/cli/commands/convert.cpp
msgid "Write a subtitle file out in another format or shape"
msgstr "Skrifa skjátextaskrá út á öðru sniði eða í annarri mynd"

#: src/exe/cli/commands/convert.cpp
msgid "Subtitle files to convert"
msgstr "Skjátextaskrár til að umbreyta"

#: src/exe/cli/commands/convert.cpp
msgid "Format to write"
msgstr "Snið til að skrifa"

#: src/exe/cli/commands/convert.cpp
msgid "Line endings to write; the source's by default"
msgstr "Línulok til að skrifa; sjálfgefið þau sömu og í upprunanum"

#: src/exe/cli/commands/convert.cpp
msgid "Encoding to write; the source's by default"
msgstr "Stafakóðun til að skrifa; sjálfgefið sú sama og í upprunanum"

#: src/exe/cli/commands/convert.cpp src/exe/cli/commands/inspect.cpp
msgid "Frame rate of a file counted in frames: 25, 23.976"
msgstr "Rammatíðni skráar sem er talin í römmum: 25, 23.976"

#: src/exe/cli/commands/convert.cpp
msgid "Write a byte order mark"
msgstr "Skrifa bætaröðunarmerki (byte order mark)"

#: src/exe/cli/commands/convert.cpp
msgid "Write no byte order mark"
msgstr "Skrifa ekkert bætaröðunarmerki"

#: src/exe/cli/commands/convert.cpp
msgid "Join the subtitles that repeat each other into one, before writing"
msgstr "Sameina skjátexta sem endurtaka hver annan í einn, áður en skrifað er"

#: src/exe/cli/commands/convert.cpp
msgid "Join the repeats, sort, then make the ranges disjoint, before writing"
msgstr ""
"Sameina endurtekningarnar, raða og láta tímabilin svo ekki skarast, áður en "
"skrifað er"

#: src/exe/cli/commands/correct.cpp
msgid "Correct the texts with the patterns of the correction assistant"
msgstr "Leiðrétta textana með mynstrum leiðréttingarhjálparinnar"

#: src/exe/cli/commands/correct.cpp
msgid "Subtitle files to correct"
msgstr "Skjátextaskrár til að leiðrétta"

#: src/exe/cli/commands/correct.cpp
msgid "The tasks to run, in a list: none is chosen beforehand"
msgstr "Verkin sem á að keyra, í lista: ekkert er valið fyrirfram"

#: src/exe/cli/commands/correct.cpp
msgid "The cascade of patterns the tasks read: Zyyy, Latn, Latn-en, Latn-en-US"
msgstr "Mynsturröðin sem verkin lesa: Zyyy, Latn, Latn-en, Latn-en-US"

#: src/exe/cli/commands/correct.cpp
msgid "The classes of common errors to apply: both by default"
msgstr "Flokkar algengra villna sem á að beita: báðir sjálfgefið"

#: src/exe/cli/commands/correct.cpp
msgid "Switch a pattern on, by its English name or type:name; repeatable"
msgstr "Kveikja á mynstri, með enska heitinu eða type:name; má endurtaka"

#: src/exe/cli/commands/correct.cpp
msgid "Switch a pattern off, by its English name or type:name; repeatable"
msgstr "Slökkva á mynstri, með enska heitinu eða type:name; má endurtaka"

#: src/exe/cli/commands/correct.cpp
msgid "The dictionary join-words and split-words read: fr_FR, en_US, en..."
msgstr "Orðabókin sem join-words og split-words lesa: fr_FR, en_US, en..."

#: src/exe/cli/commands/correct.cpp
msgid ""
"Longest line of line-break, in characters; no default, Gaupol's is in ems"
msgstr ""
"Lengsta lína línuskiptingar, í stöfum; ekkert sjálfgefið, hjá Gaupol er það "
"í em"

#: src/exe/cli/commands/correct.cpp
msgid "Most lines of line-break: 3, as Gaupol's"
msgstr "Flestar línur línuskiptingar: 3, eins og hjá Gaupol"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave alone a subtitle whose longest line is within this, or off: --max-"
"length"
msgstr ""
"Láta skjátexta í friði ef lengsta lína hans er innan þessa marks, eða off: --"
"max-length"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave alone a subtitle whose line count is within this, or off: --max-lines"
msgstr ""
"Láta skjátexta í friði ef línufjöldi hans er innan þessa marks, eða off: --"
"max-lines"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave the subtitles the correction empties, empty, instead of removing them"
msgstr ""
"Láta skjátextana sem leiðréttingin tæmir vera tóma í stað þess að fjarlægja "
"þá"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Remove the subtitles the correction empties, whatever the settings file says"
msgstr ""
"Fjarlægja skjátextana sem leiðréttingin tæmir, hvað sem stillingaskráin segir"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Put dialogue dashes on the lines, or take them off"
msgstr "Setja þankastrik fyrir samtal á línurnar, eða taka þau af"

#: src/exe/cli/commands/dialogue_dashes.cpp src/exe/cli/commands/italics.cpp
#: src/exe/cli/commands/letter_case.cpp src/exe/cli/commands/replace.cpp
msgid "Subtitle files to change"
msgstr "Skjátextaskrár til að breyta"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Put a dialogue dash at the head of the lines"
msgstr "Setja þankastrik fyrir samtal í upphaf línanna"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Take the dialogue dashes off"
msgstr "Taka þankastrikin fyrir samtal af"

#: src/exe/cli/commands/disjoint.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, merging what "
"overlaps"
msgstr ""
"Stytta skjátexta sem skarast þannig að ekkert tímabil skarist við annað, með "
"því að sameina það sem skarast"

#: src/exe/cli/commands/disjoint.cpp
msgid "Subtitle files to make disjoint"
msgstr "Skjátextaskrár til að láta tímabilin ekki skarast"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid ""
"Shortest interval kept; a shorter one is taken over by a neighbour (default "
"0.08)"
msgstr ""
"Stysta bil sem er haldið; styttra bil er tekið yfir af nágranna (sjálfgefið "
"0.08)"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid ""
"Most lines of a merged subtitle; more are shown in windows, 0 for no limit "
"(default 2)"
msgstr ""
"Flestar línur í sameinuðum skjátexta; fleiri eru sýndar í gluggum, 0 fyrir "
"engin takmörk (sjálfgefið 2)"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid "Put a dash before the text of each merged subtitle"
msgstr "Setja þankastrik á undan texta hvers sameinaðs skjátexta"

#: src/exe/cli/commands/disjoint.cpp
msgid ""
"Put the subtitles in order of their start first; without it, a file out of "
"order is refused"
msgstr ""
"Raða skjátextunum fyrst eftir upphafi; án þessa er skrá í rangri röð hafnað"

#: src/exe/cli/commands/framerate.cpp
msgid "Re-time a file mastered at one frame rate for another"
msgstr "Tímastilla skrá sem er gerð fyrir eina rammatíðni fyrir aðra"

#: src/exe/cli/commands/framerate.cpp
msgid "Subtitle files to re-time"
msgstr "Skjátextaskrár til að tímastilla"

#: src/exe/cli/commands/framerate.cpp
msgid "Frame rate the file is timed at: 25, 23.976"
msgstr "Rammatíðnin sem skráin er tímastillt á: 25, 23.976"

#: src/exe/cli/commands/framerate.cpp
msgid "Frame rate to time it for: 24, 29.97"
msgstr "Rammatíðnin sem á að tímastilla fyrir: 24, 29.97"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Remove the sounds described between square brackets"
msgstr "Fjarlægja hljóðin sem eru lýst milli hornklofa"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Subtitle files to clean"
msgstr "Skjátextaskrár til að hreinsa"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Also remove the sounds between parentheses, often whispered lines"
msgstr "Fjarlægja líka hljóðin milli sviga, oft hvíslaðar línur"

#: src/exe/cli/commands/inspect.cpp
msgid "Report what a subtitle file is made of"
msgstr "Skýra frá úr hverju skjátextaskrá er gerð"

#: src/exe/cli/commands/inspect.cpp
msgid "Subtitle files to report on"
msgstr "Skjátextaskrár til að skýra frá"

#: src/exe/cli/commands/inspect.cpp
msgid "List every anomaly, subtitle by subtitle, instead of counting them"
msgstr ""
"Telja upp öll frávik, skjátexta fyrir skjátexta, í stað þess að telja þau"

#: src/exe/cli/commands/italics.cpp
msgid "Put the texts in italics, or take their italics out"
msgstr "Setja textana í skáletur, eða taka skáletrið úr þeim"

#: src/exe/cli/commands/italics.cpp
msgid "Put the texts in italics"
msgstr "Setja textana í skáletur"

#: src/exe/cli/commands/italics.cpp
msgid "Take the italics out"
msgstr "Taka skáletrið úr"

#: src/exe/cli/commands/join_repeats.cpp
msgid ""
"Join the subtitles that repeat each other, one after the other, into one"
msgstr ""
"Sameina skjátexta sem endurtaka hver annan, hvern á eftir öðrum, í einn"

#: src/exe/cli/commands/join_repeats.cpp
msgid "Subtitle files to join the repeats of"
msgstr "Skjátextaskrár til að sameina endurtekningar í"

#: src/exe/cli/commands/letter_case.cpp
msgid "Put the texts in title, sentence, upper or lower case, tags intact"
msgstr ""
"Setja textana í fyrirsagnar-, setninga-, há- eða lágstafi, án þess að snerta "
"kóða"

#: src/exe/cli/commands/letter_case.cpp
msgid "The case to put the texts in"
msgstr "Stafstaðan sem textarnir eru settir í"

#: src/exe/cli/commands/pair.cpp
msgid ""
"Write a translation at the positions of its main file, and say how it lined "
"up"
msgstr ""
"Skrifa þýðingu á stöður aðalskrárinnar og segja hvernig hún féll að henni"

#: src/exe/cli/commands/pair.cpp
msgid "The main subtitle file"
msgstr "Aðalskjátextaskráin"

#: src/exe/cli/commands/pair.cpp
msgid "pair needs the translation file to lay over the main one: use -t"
msgstr ""
"pair krefst þýðingarskrárinnar til að leggja yfir aðalskrána: notaðu -t"

#: src/exe/cli/commands/repair.cpp
msgid ""
"Join the repeated subtitles, put them in order, then make the ranges disjoint"
msgstr ""
"Sameina endurteknu skjátextana, raða þeim og láta tímabilin svo ekki skarast"

#: src/exe/cli/commands/repair.cpp
msgid "Subtitle files to repair"
msgstr "Skjátextaskrár til að lagfæra"

#: src/exe/cli/commands/replace.cpp
msgid "Replace a text in the subtitles, without breaking a tag"
msgstr "Skipta út texta í skjátextunum án þess að brjóta kóða"

#: src/exe/cli/commands/replace.cpp
msgid "Text to look for in what is shown"
msgstr "Texti til að leita að í því sem er sýnt"

#: src/exe/cli/commands/replace.cpp
msgid "What replaces it, tags allowed"
msgstr "Það sem kemur í staðinn, kóðar leyfðir"

#: src/exe/cli/commands/replace.cpp
msgid "Read the text to look for as a regular expression"
msgstr "Lesa textann sem leitað er að sem reglulega segð"

#: src/exe/cli/commands/replace.cpp
msgid "Tell capitals from small letters"
msgstr "Gera greinarmun á há- og lágstöfum"

#: src/exe/cli/commands/shift.cpp
msgid "Move every position of a file by a fixed amount"
msgstr "Færa allar tímasetningar skráar um fasta stærð"

#: src/exe/cli/commands/shift.cpp
msgid "Subtitle files to shift"
msgstr "Skjátextaskrár til að færa"

#: src/exe/cli/commands/shift.cpp
msgid "Amount to move by: 2.999, -7.001, or 00:00:07.001"
msgstr "Stærð til að færa um: 2.999, -7.001, eða 00:00:07.001"

#: src/exe/cli/commands/shift.cpp
msgid "Move by the amount that puts the positions back on their frame grid"
msgstr "Færa um stærðina sem setur tímasetningarnar aftur á rammanet sitt"

#: src/exe/cli/commands/snap.cpp
msgid ""
"Move every position onto the nearest frame of a frame rate (see framerate)"
msgstr ""
"Færa allar tímasetningar á næsta ramma tiltekinnar rammatíðni (sjá framerate)"

#: src/exe/cli/commands/snap.cpp
msgid "Subtitle files to align"
msgstr "Skjátextaskrár til að jafna"

#: src/exe/cli/commands/snap.cpp
msgid "Frame rate to align on: 25, 23.976"
msgstr "Rammatíðni til að jafna á: 25, 23.976"

#: src/exe/cli/commands/sort.cpp
msgid "Put the subtitles in the order of their start, keeping ties as they are"
msgstr "Raða skjátextunum eftir upphafi og halda jafnteflum eins og þau eru"

#: src/exe/cli/commands/sort.cpp
msgid "Subtitle files to sort"
msgstr "Skjátextaskrár til að raða"

#: src/exe/cli/commands/split_file.cpp
msgid "Cut a subtitle file in two, a head and a tail"
msgstr "Skera skjátextaskrá í tvennt, haus og hala"

#: src/exe/cli/commands/split_file.cpp
msgid "Subtitle file to cut"
msgstr "Skjátextaskrá til að skera"

#: src/exe/cli/commands/split_file.cpp
msgid "Number of the first subtitle of the tail, as the table numbers them"
msgstr "Númer fyrsta skjátexta halans, eins og taflan númerar þá"

#: src/exe/cli/commands/split_file.cpp
msgid "File to write the subtitles before the cut to"
msgstr "Skrá til að skrifa skjátextana fyrir skurðinn í"

#: src/exe/cli/commands/split_file.cpp
msgid "File to write the subtitles from the cut on to"
msgstr "Skrá til að skrifa skjátextana frá skurðinum og áfram í"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Put the subtitles in order of their start before cutting; --at counts in "
"that order"
msgstr ""
"Raða skjátextunum eftir upphafi áður en skorið er; --at telur í þeirri röð"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before cutting"
msgstr ""
"Stytta skjátexta sem skarast þannig að ekkert tímabil skarist við annað, "
"áður en skorið er"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"no destination given: split-file writes two files, use --head and --tail"
msgstr ""
"enginn áfangastaður gefinn: split-file skrifar tvær skrár, notaðu --head og "
"--tail"

#: src/exe/cli/commands/split_file.cpp
msgid "--head and --tail go together: give both, or neither with --dry-run"
msgstr "--head og --tail fara saman: gefðu bæði, eða hvorugt með --dry-run"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the speech of a video or an audio file as subtitles"
msgstr "Skrifa tal myndskeiðs eða hljóðskrár sem skjátexta"

#: src/exe/cli/commands/transcribe.cpp
msgid "Video or audio file to transcribe"
msgstr "Myndskeið eða hljóðskrá til umritunar"

#: src/exe/cli/commands/transcribe.cpp
msgid "Subtitle file to write"
msgstr "Skjátextaskrá til að skrifa"

#: src/exe/cli/commands/transcribe.cpp
msgid "Format to write; the one the extension of --output says by default"
msgstr ""
"Snið til að skrifa; sjálfgefið það sem skráarending --output segir til um"

#: src/exe/cli/commands/transcribe.cpp
msgid "Audio track of a video, counted from 0; the first by default"
msgstr "Hljóðrás myndskeiðs, talin frá 0; sjálfgefið sú fyrsta"

#: src/exe/cli/commands/transcribe.cpp
msgid "Where to begin, as 2:00, 1:02:03 or seconds; the beginning by default"
msgstr ""
"Hvar á að byrja, til dæmis 2:00, 1:02:03 eða í sekúndum; upphafið sjálfgefið"

#: src/exe/cli/commands/transcribe.cpp
msgid "Where to stop, as 2:00, 1:02:03 or seconds; the end by default"
msgstr ""
"Hvar á að hætta, til dæmis 2:00, 1:02:03 eða í sekúndum; endirinn sjálfgefið"

#: src/exe/cli/commands/transcribe.cpp
msgid ""
"Language of the speech, two letters: fr, en, de; detected from the first 30 "
"seconds by default"
msgstr ""
"Tungumál talmálsins, tveir stafir: fr, en, de; greint af fyrstu 30 "
"sekúndunum sjálfgefið"

#: src/exe/cli/commands/transcribe.cpp
msgid "Model file; the transcription.model setting by default"
msgstr "Líkanaskrá; sjálfgefið stillingin transcription.model"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Vél; sjálfgefið stillingin transcription.engine"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "Geyma útdregna hljóðið í þessari skrá"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the segments as the engine cut them"
msgstr "Skrifa búta eins og vélin skar þá"

#: src/exe/cli/commands/transform.cpp
msgid "Correct every position from two points known to be right"
msgstr ""
"Leiðrétta allar tímasetningar út frá tveimur punktum sem vitað er að eru "
"réttir"

#: src/exe/cli/commands/transform.cpp
msgid "Subtitle files to transform"
msgstr "Skjátextaskrár til að ummynda"

#: src/exe/cli/commands/transform.cpp
msgid "Earlier reference, as <index>=<time>: 1=00:00:01.000"
msgstr "Fyrri viðmiðun, sem <index>=<time>: 1=00:00:01.000"

#: src/exe/cli/commands/transform.cpp
msgid "Later reference, as <index>=<time>: 3=00:00:10.000"
msgstr "Síðari viðmiðun, sem <index>=<time>: 3=00:00:10.000"

