msgstr ""
"Beszédaktivitás-modell, amely kihagyja a csendet; alapértelmezés szerint a "
"transcription.vad-model beállítás"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Motor; alapértelmezés szerint a transcription.engine beállítás"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "A kinyert hang megőrzése ebben a fájlban"

#: src/exe/cli/commands/transcribe.cpp
msgid ""
"List the languages the engine offers for the model, and transcribe nothing"
msgstr "A motor által a modellhez kínált nyelvek listázása, leiratozás nélkül"

#: src/exe/cli/commands/transcribe.cpp
