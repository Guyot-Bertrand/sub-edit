#: src/exe/cli/application.cpp
msgid "Display program version information and exit"
msgstr "Kiírja a program verzióját, és kilép"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr ""
"Bőbeszédűbb kimenet: a -v az alapértelmezett, a -vv részletez, a -vvv "
"hibakeresési üzeneteket is ír"

