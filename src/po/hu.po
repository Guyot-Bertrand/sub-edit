#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# A subedit beállításai.\n"
"#\n"
"# Az alapértéken hagyott beállítások megjegyzésként vannak kiírva.\n"
"# Egy sor felülbírálásához távolítsa el a megjegyzésjelet, és módosítsa\n"
"# az értékét; az alapértékre való visszatéréshez törölje a sort, bármi\n"
"# is legyen az alapérték egy későbbi változatban.\n"
"#\n"
"# Kettő közülük alapértelmezés szerint azt kapja, amit az ablak választ,\n"
"# nem egy számot: kommentezett soruk egy érték alakját mutatja, nem\n"
"# érvényben lévő alapértéket.\n"
"#\n"
"# Az az érték, amelyet ez a fájl nem tud beolvasni, az alapértéken marad,\n"
"# amit a program indulásakor a szabványos hibakimeneten közöl.\n"

#: src/lib/subedit/core/wording/settings.cpp
