msgid "Form of the result on standard output: text or json"
msgstr "Az eredmény alakja a szabványos kimeneten: text vagy json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr ""
"A műveleti beállítások olvasása a FILE fájlból a felhasználó beállításfájlja "
"helyett"

#: src/exe/cli/application.cpp
msgid "Ignore any settings file: use the built-in defaults"
msgstr ""
"Minden beállításfájl figyelmen kívül hagyása: a beépített alapértékek "
"használata"

#: src/exe/cli/application.cpp
msgid "Write the encodings that can be read and written, one a line, and stop"
msgstr "Az olvasható és írható kódolások kiírása soronként egyet, majd kilépés"

#: src/exe/cli/application.cpp
msgid "--config needs a file name"
msgstr "a --config fájlnevet igényel"

#: src/exe/cli/commands/adjust.cpp
msgid "Bring the duration of every subtitle within a reading speed and limits"
msgstr ""
"Minden felirat időtartamának igazítása egy olvasási sebességhez és "
"korlátokhoz"

#: src/exe/cli/commands/adjust.cpp
msgid "Subtitle files to adjust"
msgstr "Az igazítandó feliratfájlok"

#: src/exe/cli/commands/adjust.cpp
msgid "Reading speed in characters per second, or off (default 15)"
msgstr "Olvasási sebesség karakter/másodpercben, vagy off (alapértelmezés: 15)"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed bring an end earlier"
msgstr "Az olvasási sebesség hozhasson korábbra egy végpontot"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed bring an end earlier"
msgstr "Az olvasási sebesség ne hozhasson korábbra végpontot"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Az olvasási sebesség tolhasson későbbre egy végpontot"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "Az olvasási sebesség ne tolhasson későbbre végpontot"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "A legrövidebb időtartam, vagy off (alapértelmezés: 1.5)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "A leghosszabb időtartam, vagy off (alapértelmezés: nincs)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr ""
"A következő feliratig hagyandó legkisebb idő, vagy off (alapértelmezés: 0)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Feliratfájlok egymás után fűzése egyetlen fájlba"

#: src/exe/cli/commands/append.cpp
msgid "The base file, then the files to put after it, in order"
msgstr "Az alapfájl, majd az utána fűzendő fájlok sorrendben"

#: src/exe/cli/commands/append.cpp
msgid "File to write"
msgstr "Az írandó fájl"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/command.cpp
#: src/exe/cli/commands/split_file.cpp
msgid "Work out and say what would be written, and write nothing"
msgstr "A kiírandó tartalom kiszámítása és közlése, írás nélkül"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid "Put the subtitles in order of their start before writing"
msgstr "A feliratok rendezése kezdetük szerint az írás előtt"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before writing"
msgstr ""
"Az átfedő feliratok szétvágása az írás előtt, hogy egy tartomány se fedjen "
"át másikat"

#: src/exe/cli/commands/append.cpp
msgid "append needs a base file and at least one file to put after it"
msgstr "az append alapfájlt és legalább egy utána fűzendő fájlt igényel"

#: src/exe/cli/commands/append.cpp
msgid "no destination given: append writes one file, use --output"
msgstr ""
"nincs megadva cél: az append egyetlen fájlt ír, használja a --output "
"kapcsolót"

#: src/exe/cli/commands/command.cpp
msgid "File to write, for a single input"
msgstr "Az írandó fájl, egyetlen bemenet esetén"

#: src/exe/cli/commands/command.cpp
msgid "Directory to write into"
msgstr "A könyvtár, amelybe írni kell"

#: src/exe/cli/commands/command.cpp
msgid "Write back over the inputs"
msgstr "Visszaírás a bemenetek fölé"

#: src/exe/cli/commands/command.cpp
msgid "Take directories as inputs, and every subtitle file in them"
msgstr ""
"Könyvtárak elfogadása bemenetként, az összes bennük lévő feliratfájllal "
"együtt"

#: src/exe/cli/commands/command.cpp
msgid "Act only on subtitles N to M, or N to the end"
msgstr "Csak az N.–M. feliratra vonatkozzon, vagy az N.-től az utolsóig"

#: src/exe/cli/commands/command.cpp
