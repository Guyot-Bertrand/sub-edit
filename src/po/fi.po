#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# subeditin asetukset.\n"
"#\n"
"# Oletusarvoonsa jätetyt valinnat kirjoitetaan kommentoituina. Poista\n"
"# rivin kommenttimerkki ja muuta sen arvoa ohittaaksesi oletuksen;\n"
"# poista rivi palataksesi oletukseen, oli se myöhemmässä versiossa\n"
"# mikä tahansa.\n"
"#\n"
"# Kahden valinnan oletus on se, minkä ikkuna valitsee, eikä luku:\n"
"# niiden kommentoitu rivi näyttää arvon muodon, ei voimassa olevaa\n"
"# oletusta.\n"
"#\n"
"# Arvo, jota tämä tiedosto ei pysty lukemaan, jätetään oletukseensa,\n"
"# ja siitä kerrotaan vakiovirhetulosteessa ohjelman käynnistyessä.\n"

#: src/lib/subedit/core/wording/settings.cpp
msgid "cannot be read, keeping the default"
msgstr "ei voi lukea, oletus säilytetty"

#: src/lib/subedit/core/wording/settings.cpp
msgid "settings could not be written"
msgstr "asetuksia ei voitu kirjoittaa"

