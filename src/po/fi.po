msgid "Where to begin, as 2:00, 1:02:03 or seconds; the beginning by default"
msgstr ""
"Mistä aloitetaan, muodossa 2:00, 1:02:03 tai sekunteina; oletuksena alku"

#: src/exe/cli/commands/transcribe.cpp
msgid "Where to stop, as 2:00, 1:02:03 or seconds; the end by default"
msgstr ""
"Mihin lopetetaan, muodossa 2:00, 1:02:03 tai sekunteina; oletuksena loppu"

#: src/exe/cli/commands/transcribe.cpp
#: src/exe/cli/commands/transcribe.cpp
msgid "Language of the speech, two letters: fr, en, de; detected from the first 30 seconds by default"
msgstr "Puheen kieli, kaksi kirjainta: fr, en, de; oletuksena tunnistetaan ensimmäisten 30 sekunnin perusteella"

#: src/exe/cli/commands/transcribe.cpp
msgid "Model file; the transcription.model setting by default"
msgstr "Mallitiedosto; oletuksena asetus transcription.model"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Moottori; oletuksena asetus transcription.engine"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "Säilytä purettu ääni tässä tiedostossa"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the segments as the engine cut them"
msgstr "Kirjoita segmentit sellaisina kuin moottori ne leikkasi"

