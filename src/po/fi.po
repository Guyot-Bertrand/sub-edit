msgstr "Korjaa jokainen kohta kahden oikeaksi tiedetyn pisteen avulla"

#: src/exe/cli/commands/transform.cpp
msgid "Subtitle files to transform"
msgstr "Muunnettavat tekstitystiedostot"

#: src/exe/cli/commands/transform.cpp
