#: src/lib/subedit/core/config/operation_settings.cpp
msgid "a whole number of milliseconds, 1 to 3600000"
msgstr "целое число миллисекунд, от 1 до 3600000"

#: src/lib/subedit/core/config/operation_settings.cpp
