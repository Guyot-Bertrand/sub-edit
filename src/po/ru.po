#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Настройки subedit.\n"
"#\n"
"# Параметры со значением по умолчанию записаны закомментированными. "
"Раскомментируйте\n"
"# строку и измените значение, чтобы переопределить его; удалите строку, "
"чтобы вернуться\n"
"# к значению по умолчанию, каким бы оно ни стало в следующей версии.\n"
"#\n"
"# Два из них по умолчанию принимают то, что выберет окно, а не число:\n"
"# их закомментированная строка показывает вид значения, а не действующее\n"
"# значение по умолчанию.\n"
"#\n"
"# Значение, которое этот файл не может прочитать, остаётся по умолчанию, о "
"чём\n"
"# сообщается в стандартный поток ошибок при запуске программы.\n"

