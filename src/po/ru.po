msgstr[1] "Преобразовано субтитров: %1 (по точкам %2 и %3)"
msgstr[2] "Преобразовано субтитров: %1 (по точкам %2 и %3)"
msgstr[3] "Преобразовано субтитров: %1 (по точкам %2 и %3)"

