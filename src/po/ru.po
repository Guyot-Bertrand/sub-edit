msgid "List, show and change the operation settings"
msgstr "Просмотр и изменение настроек операций"

#: src/exe/cli/commands/config.cpp
msgid ""
"Write every operation key, what it is for, what it accepts and its default"
msgstr ""
"Вывести каждый ключ операции: назначение, допустимые значения и значение по "
"умолчанию"

#: src/exe/cli/commands/config.cpp
msgid "Write the settings file used, then every operation key with its value"
msgstr ""
"Вывести используемый файл настроек, затем каждый ключ операции с его "
"значением"

#: src/exe/cli/commands/config.cpp
msgid "Write KEY = VALUE into the settings file, keeping every other setting"
msgstr "Записать KEY = VALUE в файл настроек, сохранив все остальные настройки"

#: src/exe/cli/commands/config.cpp
msgid "Operation key, as config list names it"
msgstr "Ключ операции, как его называет config list"

#: src/exe/cli/commands/config.cpp
msgid "Value, as config list says it accepts"
msgstr "Значение, как его описывает config list"

#: src/exe/cli/commands/config.cpp
msgid ""
"Put KEY back to its default in the settings file, keeping every other setting"
msgstr ""
"Вернуть KEY к значению по умолчанию в файле настроек, сохранив все остальные "
"настройки"

#: src/exe/cli/commands/config.cpp
msgid "--no-config has nothing to write to"
msgstr "--no-config: некуда записывать"

#: src/exe/cli/commands/config.cpp
msgid "no settings file could be located; give one with --config FILE"
msgstr "файл настроек не найден; укажите его параметром --config FILE"

#: src/exe/cli/commands/convert.cpp
msgid "Write a subtitle file out in another format or shape"
msgstr "Записать файл субтитров в другом формате или виде"

#: src/exe/cli/commands/convert.cpp
msgid "Subtitle files to convert"
msgstr "Файлы субтитров для конвертации"

#: src/exe/cli/commands/convert.cpp
msgid "Format to write"
msgstr "Формат записи"

#: src/exe/cli/commands/convert.cpp
msgid "Line endings to write; the source's by default"
msgstr "Окончания строк при записи; по умолчанию как в источнике"

#: src/exe/cli/commands/convert.cpp
msgid "Encoding to write; the source's by default"
msgstr "Кодировка записи; по умолчанию как в источнике"

#: src/exe/cli/commands/convert.cpp src/exe/cli/commands/inspect.cpp
msgid "Frame rate of a file counted in frames: 25, 23.976"
msgstr "Частота кадров файла, считаемого в кадрах: 25, 23.976"

#: src/exe/cli/commands/convert.cpp
msgid "Write a byte order mark"
msgstr "Записывать метку порядка байтов"

#: src/exe/cli/commands/convert.cpp
msgid "Write no byte order mark"
msgstr "Не записывать метку порядка байтов"

#: src/exe/cli/commands/convert.cpp
msgid "Join the subtitles that repeat each other into one, before writing"
msgstr "Перед записью объединить повторяющие друг друга субтитры в один"

#: src/exe/cli/commands/convert.cpp
msgid "Join the repeats, sort, then make the ranges disjoint, before writing"
msgstr ""
"Перед записью объединить повторы, упорядочить субтитры, затем сделать "
"интервалы непересекающимися"

#: src/exe/cli/commands/correct.cpp
msgid "Correct the texts with the patterns of the correction assistant"
msgstr "Исправить тексты по шаблонам помощника исправления"

#: src/exe/cli/commands/correct.cpp
msgid "Subtitle files to correct"
msgstr "Файлы субтитров для исправления"

#: src/exe/cli/commands/correct.cpp
msgid "The tasks to run, in a list: none is chosen beforehand"
msgstr "Выполняемые задачи списком: заранее не выбрана ни одна"

#: src/exe/cli/commands/correct.cpp
msgid "The cascade of patterns the tasks read: Zyyy, Latn, Latn-en, Latn-en-US"
msgstr "Каскад шаблонов, читаемых задачами: Zyyy, Latn, Latn-en, Latn-en-US"

#: src/exe/cli/commands/correct.cpp
msgid "The classes of common errors to apply: both by default"
msgstr "Применяемые классы типичных ошибок: по умолчанию оба"

#: src/exe/cli/commands/correct.cpp
msgid "Switch a pattern on, by its English name or type:name; repeatable"
msgstr ""
"Включить шаблон по английскому названию или по type:name; можно повторять"

#: src/exe/cli/commands/correct.cpp
msgid "Switch a pattern off, by its English name or type:name; repeatable"
msgstr ""
"Выключить шаблон по английскому названию или по type:name; можно повторять"

#: src/exe/cli/commands/correct.cpp
msgid "The dictionary join-words and split-words read: fr_FR, en_US, en..."
msgstr "Словарь для join-words и split-words: fr_FR, en_US, en…"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Longest line of line-break, in characters; no default, Gaupol's is in ems"
msgstr ""
"Наибольшая длина строки для line-break в символах; значения по умолчанию "
"нет, у Gaupol она задана в эм"

#: src/exe/cli/commands/correct.cpp
msgid "Most lines of line-break: 3, as Gaupol's"
msgstr "Наибольшее число строк для line-break: 3, как у Gaupol"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave alone a subtitle whose longest line is within this, or off: --max-"
"length"
msgstr ""
"Не трогать субтитр, у которого самая длинная строка не превышает это "
"значение, или off: --max-length"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave alone a subtitle whose line count is within this, or off: --max-lines"
msgstr ""
"Не трогать субтитр, у которого число строк не превышает это значение, или "
"off: --max-lines"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Leave the subtitles the correction empties, empty, instead of removing them"
msgstr ""
"Оставлять субтитры, опустошённые исправлением, пустыми, а не удалять их"

#: src/exe/cli/commands/correct.cpp
msgid ""
"Remove the subtitles the correction empties, whatever the settings file says"
msgstr ""
"Удалять субтитры, опустошённые исправлением, независимо от файла настроек"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Put dialogue dashes on the lines, or take them off"
msgstr "Поставить тире диалога в строки или убрать их"

#: src/exe/cli/commands/dialogue_dashes.cpp src/exe/cli/commands/italics.cpp
#: src/exe/cli/commands/letter_case.cpp src/exe/cli/commands/replace.cpp
msgid "Subtitle files to change"
msgstr "Файлы субтитров для изменения"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Put a dialogue dash at the head of the lines"
msgstr "Ставить тире диалога в начале строк"

#: src/exe/cli/commands/dialogue_dashes.cpp
msgid "Take the dialogue dashes off"
msgstr "Убрать тире диалога"

#: src/exe/cli/commands/disjoint.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, merging what "
"overlaps"
msgstr ""
"Обрезать пересекающиеся субтитры, чтобы ни один интервал не пересекал "
"другой, объединяя пересекающееся"

#: src/exe/cli/commands/disjoint.cpp
msgid "Subtitle files to make disjoint"
msgstr "Файлы субтитров, в которых нужно устранить пересечения"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid ""
"Shortest interval kept; a shorter one is taken over by a neighbour (default "
"0.08)"
msgstr ""
"Наименьший сохраняемый интервал; более короткий поглощается соседним (по "
"умолчанию 0.08)"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid ""
"Most lines of a merged subtitle; more are shown in windows, 0 for no limit "
"(default 2)"
msgstr ""
"Наибольшее число строк объединённого субтитра; лишнее показывается в "
"отдельных окнах, 0 — без предела (по умолчанию 2)"

#: src/exe/cli/commands/disjoint.cpp src/exe/cli/commands/repair.cpp
msgid "Put a dash before the text of each merged subtitle"
msgstr "Ставить тире перед текстом каждого объединённого субтитра"

#: src/exe/cli/commands/disjoint.cpp
msgid ""
"Put the subtitles in order of their start first; without it, a file out of "
"order is refused"
msgstr ""
"Сначала упорядочить субтитры по времени начала; без этого файл с нарушенным "
"порядком отклоняется"

#: src/exe/cli/commands/framerate.cpp
msgid "Re-time a file mastered at one frame rate for another"
msgstr ""
"Пересчитать время файла, подготовленного для одной частоты кадров, под другую"

#: src/exe/cli/commands/framerate.cpp
msgid "Subtitle files to re-time"
msgstr "Файлы субтитров для пересчёта времени"

#: src/exe/cli/commands/framerate.cpp
msgid "Frame rate the file is timed at: 25, 23.976"
msgstr "Частота кадров, для которой рассчитано время файла: 25, 23.976"

#: src/exe/cli/commands/framerate.cpp
msgid "Frame rate to time it for: 24, 29.97"
msgstr "Частота кадров, под которую пересчитать время: 24, 29.97"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Remove the sounds described between square brackets"
msgstr "Удалить звуки, описанные в квадратных скобках"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Subtitle files to clean"
msgstr "Файлы субтитров для очистки"

#: src/exe/cli/commands/hearing_impaired.cpp
msgid "Also remove the sounds between parentheses, often whispered lines"
msgstr "Удалить также звуки в круглых скобках — часто это шёпот"

#: src/exe/cli/commands/inspect.cpp
msgid "Report what a subtitle file is made of"
msgstr "Показать, из чего состоит файл субтитров"

#: src/exe/cli/commands/inspect.cpp
msgid "Subtitle files to report on"
msgstr "Файлы субтитров для отчёта"

#: src/exe/cli/commands/inspect.cpp
msgid "List every anomaly, subtitle by subtitle, instead of counting them"
msgstr "Перечислить каждую аномалию по субтитрам вместо подсчёта"

#: src/exe/cli/commands/italics.cpp
msgid "Put the texts in italics, or take their italics out"
msgstr "Выделить тексты курсивом или убрать курсив"

#: src/exe/cli/commands/italics.cpp
msgid "Put the texts in italics"
msgstr "Выделить тексты курсивом"

#: src/exe/cli/commands/italics.cpp
msgid "Take the italics out"
msgstr "Убрать курсив"

#: src/exe/cli/commands/join_repeats.cpp
msgid ""
"Join the subtitles that repeat each other, one after the other, into one"
msgstr "Объединить в один подряд идущие субтитры, повторяющие друг друга"

#: src/exe/cli/commands/join_repeats.cpp
msgid "Subtitle files to join the repeats of"
msgstr "Файлы субтитров для объединения повторов"

#: src/exe/cli/commands/letter_case.cpp
msgid "Put the texts in title, sentence, upper or lower case, tags intact"
msgstr ""
"Привести тексты к регистру заголовка, предложения, верхнему или нижнему, не "
"затрагивая теги"

#: src/exe/cli/commands/letter_case.cpp
msgid "The case to put the texts in"
msgstr "Регистр, к которому привести тексты"

#: src/exe/cli/commands/pair.cpp
msgid ""
"Write a translation at the positions of its main file, and say how it lined "
"up"
msgstr ""
"Записать перевод по позициям основного файла и сообщить, как он сопоставился"

#: src/exe/cli/commands/pair.cpp
msgid "The main subtitle file"
msgstr "Основной файл субтитров"

#: src/exe/cli/commands/pair.cpp
msgid "pair needs the translation file to lay over the main one: use -t"
msgstr "pair требует файл перевода, накладываемый на основной: используйте -t"

#: src/exe/cli/commands/repair.cpp
msgid ""
"Join the repeated subtitles, put them in order, then make the ranges disjoint"
msgstr ""
"Объединить повторяющиеся субтитры, упорядочить их, затем сделать интервалы "
"непересекающимися"

#: src/exe/cli/commands/repair.cpp
msgid "Subtitle files to repair"
msgstr "Файлы субтитров для восстановления"

#: src/exe/cli/commands/replace.cpp
msgid "Replace a text in the subtitles, without breaking a tag"
msgstr "Заменить текст в субтитрах, не нарушая теги"

#: src/exe/cli/commands/replace.cpp
msgid "Text to look for in what is shown"
msgstr "Искомый текст среди показываемого"

#: src/exe/cli/commands/replace.cpp
msgid "What replaces it, tags allowed"
msgstr "Чем заменить; теги допускаются"

#: src/exe/cli/commands/replace.cpp
msgid "Read the text to look for as a regular expression"
msgstr "Считать искомый текст регулярным выражением"

#: src/exe/cli/commands/replace.cpp
msgid "Tell capitals from small letters"
msgstr "Различать заглавные и строчные буквы"

#: src/exe/cli/commands/shift.cpp
msgid "Move every position of a file by a fixed amount"
msgstr "Сдвинуть все позиции файла на фиксированную величину"

#: src/exe/cli/commands/shift.cpp
msgid "Subtitle files to shift"
msgstr "Файлы субтитров для сдвига"

#: src/exe/cli/commands/shift.cpp
msgid "Amount to move by: 2.999, -7.001, or 00:00:07.001"
msgstr "Величина сдвига: 2.999, -7.001 или 00:00:07.001"

#: src/exe/cli/commands/shift.cpp
msgid "Move by the amount that puts the positions back on their frame grid"
msgstr "Сдвинуть на величину, возвращающую позиции на сетку кадров"

#: src/exe/cli/commands/snap.cpp
msgid ""
"Move every position onto the nearest frame of a frame rate (see framerate)"
msgstr ""
"Сдвинуть каждую позицию на ближайший кадр заданной частоты кадров (см. "
"framerate)"

#: src/exe/cli/commands/snap.cpp
msgid "Subtitle files to align"
msgstr "Файлы субтитров для выравнивания"

#: src/exe/cli/commands/snap.cpp
msgid "Frame rate to align on: 25, 23.976"
msgstr "Частота кадров для выравнивания: 25, 23.976"

#: src/exe/cli/commands/sort.cpp
msgid "Put the subtitles in the order of their start, keeping ties as they are"
msgstr "Упорядочить субтитры по времени начала, сохраняя порядок равных"

#: src/exe/cli/commands/sort.cpp
msgid "Subtitle files to sort"
msgstr "Файлы субтитров для упорядочивания"

#: src/exe/cli/commands/split_file.cpp
msgid "Cut a subtitle file in two, a head and a tail"
msgstr ""
"Разрезать файл субтитров на две части: начальную (head) и конечную (tail)"

#: src/exe/cli/commands/split_file.cpp
msgid "Subtitle file to cut"
msgstr "Разрезаемый файл субтитров"

#: src/exe/cli/commands/split_file.cpp
msgid "Number of the first subtitle of the tail, as the table numbers them"
msgstr "Номер первого субтитра конечной части в нумерации таблицы"

#: src/exe/cli/commands/split_file.cpp
msgid "File to write the subtitles before the cut to"
msgstr "Файл для субтитров до разреза"

#: src/exe/cli/commands/split_file.cpp
msgid "File to write the subtitles from the cut on to"
msgstr "Файл для субтитров начиная с места разреза"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Put the subtitles in order of their start before cutting; --at counts in "
"that order"
msgstr ""
"Перед разрезом упорядочить субтитры по времени начала; --at считает в этом "
"порядке"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before cutting"
msgstr ""
"Перед разрезом обрезать пересекающиеся субтитры, чтобы ни один интервал не "
"пересекал другой"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"no destination given: split-file writes two files, use --head and --tail"
msgstr ""
"не указан файл назначения: split-file пишет два файла, используйте --head и "
"--tail"

#: src/exe/cli/commands/split_file.cpp
msgid "--head and --tail go together: give both, or neither with --dry-run"
msgstr ""
"--head и --tail используются вместе: укажите оба или ни одного вместе с --"
"dry-run"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the speech of a video or an audio file as subtitles"
msgstr "Записать речь видео или аудиофайла в виде субтитров"

#: src/exe/cli/commands/transcribe.cpp
msgid "Video or audio file to transcribe"
msgstr "Видео или аудиофайл для расшифровки"

#: src/exe/cli/commands/transcribe.cpp
msgid "Subtitle file to write"
msgstr "Файл субтитров для записи"

#: src/exe/cli/commands/transcribe.cpp
msgid "Format to write; the one the extension of --output says by default"
msgstr "Формат записи; по умолчанию тот, который указывает расширение --output"

#: src/exe/cli/commands/transcribe.cpp
msgid "Audio track of a video, counted from 0; the first by default"
msgstr "Звуковая дорожка видео, считая с 0; по умолчанию первая"

#: src/exe/cli/commands/transcribe.cpp
msgid "Language of the speech: fr, en; detected by default"
msgstr "Язык речи: fr, en; по умолчанию определяется автоматически"

#: src/exe/cli/commands/transcribe.cpp
msgid "Model file; the transcription.model setting by default"
msgstr "Файл модели; по умолчанию настройка transcription.model"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Движок; по умолчанию настройка transcription.engine"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "Сохранить извлечённый звук в этот файл"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the segments as the engine cut them"
msgstr "Записать сегменты так, как их разрезал движок"

#: src/exe/cli/commands/transform.cpp
msgid "Correct every position from two points known to be right"
msgstr "Исправить все позиции по двум заведомо верным точкам"

#: src/exe/cli/commands/transform.cpp
msgid "Subtitle files to transform"
msgstr "Файлы субтитров для преобразования"

#: src/exe/cli/commands/transform.cpp
msgid "Earlier reference, as <index>=<time>: 1=00:00:01.000"
msgstr "Первая опорная точка в виде <index>=<time>: 1=00:00:01.000"

#: src/exe/cli/commands/transform.cpp
msgid "Later reference, as <index>=<time>: 3=00:00:10.000"
msgstr "Вторая опорная точка в виде <index>=<time>: 3=00:00:10.000"

#. TRANSLATORS: %1 is the reason of a failure the program did not foresee.
#: src/exe/cli/main.cpp
msgid "subedit-cli: %1"
msgstr "subedit-cli: %1"

#: src/exe/cli/main.cpp
msgid "subedit-cli: unknown failure"
msgstr "subedit-cli: неизвестный сбой"

#. TRANSLATORS: %1 is what the user typed. « off » is a value of the option, as typed.
#: src/lib/subedit/cli/adjusting.cpp
msgid ""
"--speed: \"%1\" is not a reading speed: expected a number of characters per "
"second above zero, like 15 or 12.5, or off"
msgstr ""
"--speed: «%1» не скорость чтения: ожидается число символов в секунду больше "
"нуля, например 15 или 12.5, или off"

#. TRANSLATORS: %1 is an option, such as --minimum; %2 why its value does not read.
#. TRANSLATORS: %1 is the file, or what a message is about; %2 the message.
#. TRANSLATORS: %1 is Undo or Redo, %2 the operation it undoes or redoes, such as shifting.
#. TRANSLATORS: %1 is a file's path, %2 what went wrong with it.
#: src/lib/subedit/cli/adjusting.cpp src/lib/subedit/cli/batch.cpp
#: src/lib/subedit/cli/configuring.cpp src/lib/subedit/cli/conversion.cpp
#: src/lib/subedit/cli/disjoining.cpp src/lib/subedit/cli/inspection.cpp
#: src/lib/subedit/cli/joining.cpp src/lib/subedit/cli/records.cpp
#: src/lib/subedit/cli/rewriting.cpp src/lib/subedit/cli/sorting.cpp
#: src/lib/subedit/gui/command_label.cpp src/lib/subedit/gui/invocation.cpp
msgid "%1: %2"
msgstr "%1: %2"

#. TRANSLATORS: %1 is an option, such as --minimum; %2 what the user typed.
#: src/lib/subedit/cli/adjusting.cpp
msgid "%1: \"%2\" is not a duration of zero or more"
msgstr "%1: «%2» не длительность, равная нулю или больше"

#: src/lib/subedit/cli/adjusting.cpp
msgid "%1: \"%2\" is not a duration above zero"
msgstr "%1: «%2» не длительность больше нуля"

#. TRANSLATORS: %1 and %2 are two options, such as --shorten and --no-shorten.
#: src/lib/subedit/cli/adjusting.cpp src/lib/subedit/cli/correcting.cpp
msgid "%1 and %2 say opposite things; give one of them"
msgstr "%1 и %2 противоречат друг другу; укажите один из них"

#: src/lib/subedit/cli/adjusting.cpp
msgid ""
"--lengthen, --no-lengthen, --shorten and --no-shorten say which way the "
"reading speed may move an end, and --speed off switches the reading speed off"
msgstr ""
"--lengthen, --no-lengthen, --shorten и --no-shorten задают, в какую сторону "
"скорость чтения может сдвигать конец, а --speed off отключает скорость чтения"

#: src/lib/subedit/cli/adjusting.cpp
msgid ""
"adjust has nothing to adjust to: every constraint is off, or the reading "
"speed is told to move no end"
msgstr ""
"adjust не к чему приводить длительность: все ограничения отключены или "
"скорости чтения запрещено сдвигать любой конец"

#. TRANSLATORS: %1 positions moved, by at most %2 milliseconds.
#: src/lib/subedit/cli/aligning.cpp
msgid "%1 position moved, by at most %2 ms"
msgid_plural "%1 positions moved, by at most %2 ms"
msgstr[0] "Сдвинуто позиций: %1, не более чем на %2 мс"
msgstr[1] "Сдвинуто позиций: %1, не более чем на %2 мс"
msgstr[2] "Сдвинуто позиций: %1, не более чем на %2 мс"
msgstr[3] "Сдвинуто позиций: %1, не более чем на %2 мс"

#. TRANSLATORS: %1 subtitles aligned on the frame rate %2; %3 is
