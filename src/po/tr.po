msgstr ""
"Bir örüntüyü İngilizce adıyla ya da tür:ad biçiminde aç; tekrarlanabilir"

#: src/exe/cli/commands/correct.cpp
msgid "Switch a pattern off, by its English name or type:name; repeatable"
msgstr ""
"Bir örüntüyü İngilizce adıyla ya da tür:ad biçiminde kapat; tekrarlanabilir"

