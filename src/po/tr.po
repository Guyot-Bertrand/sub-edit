msgstr "Nereden başlanacağı: 2:00, 1:02:03 veya saniye; varsayılan olarak baştan"

#: src/exe/cli/commands/transcribe.cpp
#: src/exe/cli/commands/transcribe.cpp
msgid "Where to stop, as 2:00, 1:02:03 or seconds; the end by default"
msgstr "Nerede duracağı: 2:00, 1:02:03 veya saniye; varsayılan olarak sona kadar"

#: src/exe/cli/commands/transcribe.cpp
msgid "Language of the speech: fr, en; detected by default"
msgstr "Konuşmanın dili: fr, en; varsayılan olarak algılanır"

#: src/exe/cli/commands/transcribe.cpp
msgid "Model file; the transcription.model setting by default"
msgstr "Model dosyası; varsayılan olarak transcription.model ayarı"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Motor; varsayılan olarak transcription.engine ayarı"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "Çıkarılan sesi bu dosyada tut"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the segments as the engine cut them"
msgstr "Parçaları motorun kestiği gibi yaz"

