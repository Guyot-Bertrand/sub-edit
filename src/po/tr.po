msgstr "Dönüştürülecek altyazı dosyaları"

#: src/exe/cli/commands/transform.cpp
msgid "Earlier reference, as <index>=<time>: 1=00:00:01.000"
msgstr "Önceki başvuru, <sıra>=<zaman> biçiminde: 1=00:00:01.000"

