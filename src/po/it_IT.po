#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Impostazioni di subedit.\n"
"#\n"
"# Le opzioni lasciate al valore predefinito sono scritte come commento.\n"
"# Togli il commento a una riga e cambia il suo valore per sostituirlo;\n"
"# elimina la riga per tornare al valore predefinito, qualunque diventi\n"
"# in una versione successiva.\n"
"#\n"
"# Due di esse hanno come valore predefinito ciò che sceglie la finestra\n"
"# e non un numero: la loro riga commentata mostra la forma di un valore,\n"
"# non un valore predefinito in vigore.\n"
"#\n"
"# Un valore che questo file non sa leggere resta al valore predefinito,\n"
"# e lo si dice sullo standard error all'avvio del programma.\n"

