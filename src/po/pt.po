msgstr "Vídeo ou ficheiro de áudio a transcrever"

#: src/exe/cli/commands/transcribe.cpp
msgid "Subtitle file to write"
msgstr "Ficheiro de legendas a escrever"

#: src/exe/cli/commands/transcribe.cpp
msgid "Format to write; the one the extension of --output says by default"
msgstr ""
"Formato a escrever; por predefinição, o que a extensão de --output indica"

#: src/exe/cli/commands/transcribe.cpp
msgid "Audio track of a video, counted from 0; the first by default"
msgstr ""
"Faixa de áudio de um vídeo, contada a partir de 0; por predefinição, a "
"primeira"

#: src/exe/cli/commands/transcribe.cpp
msgid ""
"Do not write sounds as notes, such as (phone ringing); the transcription."
"suppress-notes setting by default"
msgstr ""
"Não escrever os sons como notas, por exemplo (phone ringing); por "
"predefinição, a definição transcription.suppress-notes"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write sounds as notes, against the setting"
msgstr "Escrever os sons como notas, contra a definição"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Motor; por predefinição, a definição transcription.engine"

