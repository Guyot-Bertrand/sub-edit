#~ msgid ""
#~ "%1 of the %2 pieces are only notes in brackets, such as [MUSIC PLAYING]: "
#~ "the language used (%3) is probably not the one spoken, and the engine may "
#~ "have translated the speech. Run it again with the language typed."
#~ msgstr ""
#~ "%1 dels %2 trossos són només notes entre claudàtors, com [MUSIC PLAYING]: "
#~ "la llengua emprada (%3) probablement no és la parlada, i el motor potser "
#~ "ha traduït la parla. Torneu-lo a executar amb la llengua escrita."

#~ msgid ""
#~ "A language code such as fr, en, de, es or it (fra and eng work too). "
#~ "Leave it empty to let the model detect the language from the first 30 "
#~ "seconds of sound."
#~ msgstr ""
#~ "Un codi de llengua com fr, en, de, es o it (fra i eng també funcionen). "
#~ "Deixeu-lo buit perquè el model detecti la llengua a partir dels primers "
#~ "30 segons de so."

#~ msgid "estimating the time left…"
#~ msgstr "estimació del temps que queda…"

#~ msgid "This model cannot detect the language: type it."
#~ msgstr "Aquest model no pot detectar la llengua: escriviu-la."

#~ msgid ""
#~ "The file declares no language for this track: the model will detect it "
#~ "from the sound. Type it if you know it."
#~ msgstr ""
#~ "El fitxer no declara cap llengua per a aquesta pista: el model la "
#~ "detectarà a partir del so. Escriviu-la si la coneixeu."

#~ msgid "Beginning"
#~ msgstr "Inici"

#~ msgid "Detected"
#~ msgstr "Detectada"

