msgstr[1] "%1 de %2 fitxers modificats"

#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file cleaned"
msgid_plural "%1 of %2 files cleaned"
msgstr[0] "%1 de %2 fitxer netejat"
msgstr[1] "%1 de %2 fitxers netejats"

#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file converted"
msgid_plural "%1 of %2 files converted"
msgstr[0] "%1 de %2 fitxer convertit"
msgstr[1] "%1 de %2 fitxers convertits"

