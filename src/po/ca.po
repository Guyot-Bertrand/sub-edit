#: src/exe/cli/application.cpp
msgid "Subcommands"
msgstr "Subordres"

#: src/exe/cli/application.cpp
msgid "Read, inspect and retime subtitle files."
msgstr "Llegeix, inspecciona i resincronitza fitxers de subtítols."

#: src/exe/cli/application.cpp
msgid "Display program version information and exit"
msgstr "Mostra la informació de la versió del programa i surt"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr ""
"Mostra'n més: -v és el valor per defecte, -vv dona detalls, -vvv depura"

#: src/exe/cli/application.cpp
msgid "Say nothing but errors"
msgstr "No mostris res excepte els errors"

#: src/exe/cli/application.cpp
msgid "Encoding to read the files in; detected by default"
msgstr "Codificació amb què es llegeixen els fitxers; detectada per defecte"

#: src/exe/cli/application.cpp
msgid "Form of the result on standard output: text or json"
msgstr "Forma del resultat a la sortida estàndard: text o json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr ""
"Llegeix la configuració de les operacions de FILE en lloc del fitxer de "
"configuració de l'usuari"

#: src/exe/cli/application.cpp
msgid "Ignore any settings file: use the built-in defaults"
msgstr ""
"Ignora qualsevol fitxer de configuració: usa els valors per defecte integrats"

#: src/exe/cli/application.cpp
msgid "Write the encodings that can be read and written, one a line, and stop"
msgstr ""
"Escriu les codificacions que es poden llegir i escriure, una per línia, i "
"atura't"

#: src/exe/cli/application.cpp
msgid "--config needs a file name"
msgstr "--config necessita un nom de fitxer"

#: src/exe/cli/commands/adjust.cpp
msgid "Bring the duration of every subtitle within a reading speed and limits"
msgstr ""
"Ajusta la durada de cada subtítol a una velocitat de lectura i uns límits"

#: src/exe/cli/commands/adjust.cpp
msgid "Subtitle files to adjust"
msgstr "Fitxers de subtítols que cal ajustar"

#: src/exe/cli/commands/adjust.cpp
msgid "Reading speed in characters per second, or off (default 15)"
msgstr "Velocitat de lectura en caràcters per segon, o off (15 per defecte)"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed bring an end earlier"
msgstr "Permet que la velocitat de lectura avanci un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed bring an end earlier"
msgstr "No permetis que la velocitat de lectura avanci un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Permet que la velocitat de lectura endarrereixi un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "No permetis que la velocitat de lectura endarrereixi un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "Durada més curta, o off (1.5 per defecte)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "Durada més llarga, o off (cap per defecte)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr ""
"Temps mínim que es deixa abans del subtítol següent, o off (0 per defecte)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Posa fitxers de subtítols l'un darrere l'altre en un sol fitxer"

#: src/exe/cli/commands/append.cpp
msgid "The base file, then the files to put after it, in order"
msgstr ""
"El fitxer de base i després els fitxers que s'hi posen al darrere, en ordre"

#: src/exe/cli/commands/append.cpp
msgid "File to write"
msgstr "Fitxer on s'escriu"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/command.cpp
#: src/exe/cli/commands/split_file.cpp
msgid "Work out and say what would be written, and write nothing"
msgstr "Calcula i digues què s'escriuria, sense escriure res"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid "Put the subtitles in order of their start before writing"
msgstr "Ordena els subtítols segons el seu inici abans d'escriure"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before writing"
msgstr ""
"Talla els subtítols que s'encavalquen perquè cap franja no s'encavalqui amb "
"una altra, abans d'escriure"

#: src/exe/cli/commands/append.cpp
msgid "append needs a base file and at least one file to put after it"
msgstr ""
"append necessita un fitxer de base i almenys un fitxer per posar-hi al "
"darrere"

#: src/exe/cli/commands/append.cpp
msgid "no destination given: append writes one file, use --output"
msgstr ""
"no s'ha indicat cap destinació: append escriu un sol fitxer, useu --output"

#: src/exe/cli/commands/command.cpp
msgid "File to write, for a single input"
msgstr "Fitxer on s'escriu, per a una sola entrada"

#: src/exe/cli/commands/command.cpp
msgid "Directory to write into"
msgstr "Directori on s'escriu"

#: src/exe/cli/commands/command.cpp
msgid "Write back over the inputs"
msgstr "Escriu damunt de les entrades"

#: src/exe/cli/commands/command.cpp
msgid "Take directories as inputs, and every subtitle file in them"
msgstr ""
"Pren directoris com a entrades, i tots els fitxers de subtítols que contenen"

#: src/exe/cli/commands/command.cpp
msgid "Act only on subtitles N to M, or N to the end"
msgstr "Actua només sobre els subtítols del N al M, o del N fins al final"

#: src/exe/cli/commands/command.cpp
msgid "Translation file to lay over the subtitle file, for a single input"
msgstr ""
"Fitxer de traducció per superposar al fitxer de subtítols, per a una sola "
"entrada"

#: src/exe/cli/commands/command.cpp
msgid "How the lines of the translation find their subtitles"
msgstr "Com troben les línies de la traducció els seus subtítols"

#: src/exe/cli/commands/command.cpp
msgid "The document to change: the main one, or the translation given by -t"
msgstr ""
"El document que cal modificar: el principal, o la traducció donada per -t"

#: src/exe/cli/commands/config.cpp
msgid "List, show and change the operation settings"
msgstr "Llista, mostra i modifica la configuració de les operacions"

#: src/exe/cli/commands/config.cpp
msgid ""
"Write every operation key, what it is for, what it accepts and its default"
msgstr ""
"Escriu cada clau d'operació, per a què serveix, què accepta i el seu valor "
"per defecte"

#: src/exe/cli/commands/config.cpp
msgid "Write the settings file used, then every operation key with its value"
msgstr ""
"Escriu el fitxer de configuració utilitzat i després cada clau d'operació "
"amb el seu valor"

#: src/exe/cli/commands/config.cpp
msgid "Write KEY = VALUE into the settings file, keeping every other setting"
msgstr ""
"Escriu KEY = VALUE al fitxer de configuració, conservant tots els altres "
"paràmetres"

#: src/exe/cli/commands/config.cpp
msgid "Operation key, as config list names it"
msgstr "Clau d'operació, tal com l'anomena config list"

#: src/exe/cli/commands/config.cpp
msgid "Value, as config list says it accepts"
msgstr "Valor, tal com config list diu que s'accepta"

#: src/exe/cli/commands/config.cpp
msgid ""
"Put KEY back to its default in the settings file, keeping every other setting"
msgstr ""
"Torna KEY al seu valor per defecte al fitxer de configuració, conservant "
"tots els altres paràmetres"

#: src/exe/cli/commands/config.cpp
msgid "--no-config has nothing to write to"
msgstr "--no-config no té on escriure"

#: src/exe/cli/commands/config.cpp
msgid "no settings file could be located; give one with --config FILE"
msgstr ""
"no s'ha pogut trobar cap fitxer de configuració; indiqueu-ne un amb --config "
"FILE"

#: src/exe/cli/commands/convert.cpp
msgid "Write a subtitle file out in another format or shape"
msgstr ""
"Torna a escriure un fitxer de subtítols en un altre format o una altra forma"

#: src/exe/cli/commands/convert.cpp
