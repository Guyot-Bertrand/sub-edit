msgid "%1 of %2 file corrected"
msgid_plural "%1 of %2 files corrected"
msgstr[0] "%1 de %2 fitxer corregit"
msgstr[1] "%1 de %2 fitxers corregits"

#: src/lib/subedit/cli/batch.cpp
msgid "%1 of %2 file inspected"
msgid_plural "%1 of %2 files inspected"
msgstr[0] "%1 de %2 fitxer examinat"
msgstr[1] "%1 de %2 fitxers examinats"

#: src/lib/subedit/cli/batch.cpp
