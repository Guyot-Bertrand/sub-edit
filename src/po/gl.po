#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Configuración de subedit.\n"
"#\n"
"# As opcións que teñen o valor predeterminado escríbense comentadas.\n"
"# Descomente unha liña e cambie o seu valor para sobrescribilo; elimine a\n"
"# liña para volver ao valor predeterminado, sexa cal sexa nunha versión\n"
"# posterior.\n"
"#\n"
"# Dúas delas teñen como predeterminado o que escolla a xanela, e non un\n"
"# número: a súa liña comentada mostra a forma dun valor, non un valor\n"
"# predeterminado en vigor.\n"
"#\n"
"# Un valor que este ficheiro non pode ler queda co seu valor\n"
"# predeterminado, e isto indícase na saída de erro estándar ao iniciar o\n"
"# programa.\n"

