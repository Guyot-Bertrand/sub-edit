msgstr "Wyświetl informacje o wersji programu i zakończ"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr ""
"Więcej komunikatów: -v jest domyślne, -vv podaje szczegóły, -vvv informacje "
"diagnostyczne"

