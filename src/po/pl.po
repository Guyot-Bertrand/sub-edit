msgstr "Postać wyniku na standardowym wyjściu: text lub json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr ""
"Odczytaj ustawienia operacji z FILE zamiast z pliku ustawień użytkownika"

