msgid "Form of the result on standard output: text or json"
msgstr "Forma del resultado en la salida estándar: text o json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr ""
"Lee la configuración de las operaciones de FILE en lugar del archivo de "
"configuración del usuario"

#: src/exe/cli/application.cpp
msgid "Ignore any settings file: use the built-in defaults"
msgstr ""
"Ignora cualquier archivo de configuración: usa los valores por defecto "
"integrados"

#: src/exe/cli/application.cpp
msgid "Write the encodings that can be read and written, one a line, and stop"
msgstr ""
"Escribe las codificaciones que se pueden leer y escribir, una por línea, y "
"se detiene"

#: src/exe/cli/application.cpp
msgid "--config needs a file name"
msgstr "--config necesita un nombre de archivo"

#: src/exe/cli/commands/adjust.cpp
msgid "Bring the duration of every subtitle within a reading speed and limits"
msgstr ""
"Ajusta la duración de cada subtítulo a una velocidad de lectura y unos "
"límites"

#: src/exe/cli/commands/adjust.cpp
msgid "Subtitle files to adjust"
msgstr "Archivos de subtítulos que ajustar"

#: src/exe/cli/commands/adjust.cpp
msgid "Reading speed in characters per second, or off (default 15)"
msgstr "Velocidad de lectura en caracteres por segundo, u off (por defecto 15)"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed bring an end earlier"
msgstr "Permite que la velocidad de lectura adelante un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed bring an end earlier"
msgstr "No permite que la velocidad de lectura adelante un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Permite que la velocidad de lectura retrase un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "No permite que la velocidad de lectura retrase un final"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "Duración mínima, u off (por defecto 1.5)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "Duración máxima, u off (por defecto: ninguna)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr "Tiempo mínimo antes del subtítulo siguiente, u off (por defecto 0)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Pone archivos de subtítulos uno tras otro en un solo archivo"

