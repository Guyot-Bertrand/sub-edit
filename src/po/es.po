msgid "Put the subtitles in order of their start before writing"
msgstr "Ordena los subtítulos por su inicio antes de escribir"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before writing"
msgstr ""
"Recorta los subtítulos solapados para que ningún intervalo solape otro, "
"antes de escribir"

#: src/exe/cli/commands/append.cpp
msgid "append needs a base file and at least one file to put after it"
msgstr ""
"append necesita un archivo base y al menos un archivo que poner tras él"

#: src/exe/cli/commands/append.cpp
msgid "no destination given: append writes one file, use --output"
msgstr ""
"no se ha indicado ningún destino: append escribe un solo archivo, indicado "
"con --output"

#: src/exe/cli/commands/command.cpp
msgid "File to write, for a single input"
msgstr "Archivo que escribir, para una sola entrada"

#: src/exe/cli/commands/command.cpp
msgid "Directory to write into"
msgstr "Directorio en el que escribir"

#: src/exe/cli/commands/command.cpp
msgid "Write back over the inputs"
msgstr "Escribe sobre las propias entradas"

#: src/exe/cli/commands/command.cpp
msgid "Take directories as inputs, and every subtitle file in them"
msgstr ""
"Toma directorios como entradas, y todos los archivos de subtítulos que "
"contienen"

#: src/exe/cli/commands/command.cpp
msgid "Act only on subtitles N to M, or N to the end"
msgstr "Actúa solo sobre los subtítulos N a M, o de N al final"

#: src/exe/cli/commands/command.cpp
msgid "Translation file to lay over the subtitle file, for a single input"
msgstr ""
"Archivo de traducción que superponer al archivo de subtítulos, para una sola "
"entrada"

