#: src/exe/cli/application.cpp
msgid "Read, inspect and retime subtitle files."
msgstr "Lee, inspecciona y reajusta los tiempos de archivos de subtítulos."

#: src/exe/cli/application.cpp
msgid "Display program version information and exit"
msgstr "Muestra la información de versión del programa y sale"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr "Dice más: -v es el valor por defecto, -vv da detalles, -vvv depura"

#: src/exe/cli/application.cpp
msgid "Say nothing but errors"
msgstr "No dice nada salvo los errores"

#: src/exe/cli/application.cpp
msgid "Encoding to read the files in; detected by default"
msgstr "Codificación con la que leer los archivos; detectada por defecto"

