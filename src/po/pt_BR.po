msgid "File to write the subtitles before the cut to"
msgstr "Arquivo onde escrever as legendas anteriores ao corte"

#: src/exe/cli/commands/split_file.cpp
msgid "File to write the subtitles from the cut on to"
msgstr "Arquivo onde escrever as legendas a partir do corte"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Put the subtitles in order of their start before cutting; --at counts in "
"that order"
msgstr ""
"Colocar as legendas em ordem de início antes de cortar; --at conta nessa "
"ordem"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before cutting"
msgstr ""
"Cortar as legendas que se sobrepõem para que nenhuma faixa se sobreponha a "
"outra, antes de cortar"

#: src/exe/cli/commands/split_file.cpp
msgid ""
"no destination given: split-file writes two files, use --head and --tail"
msgstr ""
"nenhum destino informado: split-file escreve dois arquivos, use --head e --"
"tail"

#: src/exe/cli/commands/split_file.cpp
msgid "--head and --tail go together: give both, or neither with --dry-run"
msgstr "--head e --tail andam juntos: informe os dois, ou nenhum com --dry-run"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the speech of a video or an audio file as subtitles"
msgstr ""
"Gravar a fala de um vídeo ou de um arquivo de áudio sob a forma de legendas"

#: src/exe/cli/commands/transcribe.cpp
msgid "Video or audio file to transcribe"
msgstr "Vídeo ou arquivo de áudio a transcrever"

#: src/exe/cli/commands/transcribe.cpp
msgid "Subtitle file to write"
msgstr "Arquivo de legendas a gravar"

#: src/exe/cli/commands/transcribe.cpp
msgid "Format to write; the one the extension of --output says by default"
msgstr "Formato a gravar; por padrão, o que a extensão de --output indica"

