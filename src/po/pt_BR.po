#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Configurações do subedit.\n"
"#\n"
"# As opções deixadas no padrão são escritas comentadas. Descomente uma\n"
"# linha e altere seu valor para substituí-lo; apague a linha para voltar\n"
"# ao padrão, seja qual for esse padrão em uma versão posterior.\n"
"#\n"
"# Duas delas têm como padrão o que a janela escolhe, e não um\n"
"# número: sua linha comentada mostra a forma de um valor, não um\n"
"# padrão em vigor.\n"
"#\n"
"# Um valor que este arquivo não consegue ler é mantido no padrão, e isso é "
"dito\n"
"# na saída de erro padrão quando o programa inicia.\n"

#: src/lib/subedit/core/wording/settings.cpp
msgid "cannot be read, keeping the default"
msgstr "não pôde ser lido, mantido o padrão"

