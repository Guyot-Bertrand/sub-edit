msgstr "Unir em uma só as legendas que se repetem, antes de escrever"

#: src/exe/cli/commands/convert.cpp
msgid "Join the repeats, sort, then make the ranges disjoint, before writing"
msgstr ""
"Unir as repetidas, ordenar e depois tornar as faixas disjuntas, antes de "
"escrever"

#: src/exe/cli/commands/correct.cpp
msgid "Correct the texts with the patterns of the correction assistant"
msgstr "Corrigir os textos com os padrões do assistente de correção"

#: src/exe/cli/commands/correct.cpp
