msgstr ""
"Idioma da fala, duas letras: fr, en, de; detectado por padrão a partir dos "
"primeiros 30 segundos"

#: src/exe/cli/commands/transcribe.cpp
msgid ""
"Do not write sounds as notes, such as (phone ringing); the transcription."
"suppress-notes setting by default"
msgstr ""
"Não escrever os sons como notas, por exemplo (phone ringing); por padrão, a "
"configuração transcription.suppress-notes"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write sounds as notes, against the setting"
msgstr "Escrever os sons como notas, contra a configuração"

#: src/exe/cli/commands/transcribe.cpp
msgid "Model file; the transcription.model setting by default"
msgstr "Arquivo do modelo; por padrão, a configuração transcription.model"

#: src/exe/cli/commands/transcribe.cpp
msgid "Engine; the transcription.engine setting by default"
msgstr "Motor; por padrão, a configuração transcription.engine"

#: src/exe/cli/commands/transcribe.cpp
msgid "Keep the extracted audio in this file"
msgstr "Manter o áudio extraído neste arquivo"

#: src/exe/cli/commands/transcribe.cpp
msgid ""
"List the languages the engine offers for the model, and transcribe nothing"
msgstr ""
"Listar os idiomas que o motor oferece para o modelo, e não transcrever nada"

#: src/exe/cli/commands/transcribe.cpp
msgid "Write the segments as the engine cut them"
msgstr "Gravar os segmentos como o motor os cortou"

