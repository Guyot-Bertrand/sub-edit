msgid "Write KEY = VALUE into the settings file, keeping every other setting"
msgstr ""
"Écrire KEY = VALUE dans le fichier de réglages, en gardant tous les autres "
"réglages"

#: src/exe/cli/commands/config.cpp
msgid "Operation key, as config list names it"
msgstr "Clé d'opération, telle que config list la nomme"

#: src/exe/cli/commands/config.cpp
msgid "Value, as config list says it accepts"
msgstr "Valeur, telle que config list dit qu'elle est acceptée"

#: src/exe/cli/commands/config.cpp
msgid ""
"Put KEY back to its default in the settings file, keeping every other setting"
msgstr ""
"Remettre KEY à sa valeur par défaut dans le fichier de réglages, en gardant "
"tous les autres réglages"

#: src/exe/cli/commands/config.cpp
msgid "--no-config has nothing to write to"
msgstr "--no-config n'a nulle part où écrire"

#: src/exe/cli/commands/config.cpp
msgid "no settings file could be located; give one with --config FILE"
msgstr ""
"aucun fichier de réglages n'a pu être trouvé ; donnez-en un avec --config "
