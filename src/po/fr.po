msgid "Write the encodings that can be read and written, one a line, and stop"
msgstr ""
"Écrire les encodages lisibles et inscriptibles, un par ligne, et s'arrêter"

#: src/exe/cli/application.cpp
msgid "--config needs a file name"
msgstr "--config demande un nom de fichier"

#: src/exe/cli/commands/adjust.cpp
msgid "Bring the duration of every subtitle within a reading speed and limits"
msgstr ""
"Ramener la durée de chaque sous-titre dans une vitesse de lecture et des "
"limites"

#: src/exe/cli/commands/adjust.cpp
msgid "Subtitle files to adjust"
msgstr "Fichiers de sous-titres à ajuster"

#: src/exe/cli/commands/adjust.cpp
msgid "Reading speed in characters per second, or off (default 15)"
msgstr "Vitesse de lecture en caractères par seconde, ou off (15 par défaut)"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed bring an end earlier"
msgstr "Laisser la vitesse de lecture avancer une fin"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed bring an end earlier"
msgstr "Ne pas laisser la vitesse de lecture avancer une fin"

#: src/exe/cli/commands/adjust.cpp
msgid "Let the reading speed move an end later"
msgstr "Laisser la vitesse de lecture retarder une fin"

#: src/exe/cli/commands/adjust.cpp
msgid "Do not let the reading speed move an end later"
msgstr "Ne pas laisser la vitesse de lecture retarder une fin"

#: src/exe/cli/commands/adjust.cpp
msgid "Shortest duration, or off (default 1.5)"
msgstr "Durée la plus courte, ou off (1.5 par défaut)"

#: src/exe/cli/commands/adjust.cpp
msgid "Longest duration, or off (default: none)"
msgstr "Durée la plus longue, ou off (aucune par défaut)"

#: src/exe/cli/commands/adjust.cpp
msgid "Least time left before the next subtitle, or off (default 0)"
msgstr ""
"Temps minimal laissé avant le sous-titre suivant, ou off (0 par défaut)"

#: src/exe/cli/commands/append.cpp
msgid "Put subtitle files one after another into a single file"
msgstr "Mettre des fichiers de sous-titres bout à bout dans un seul fichier"

#: src/exe/cli/commands/append.cpp
msgid "The base file, then the files to put after it, in order"
msgstr "Le fichier de base, puis les fichiers à mettre après lui, dans l'ordre"

#: src/exe/cli/commands/append.cpp
msgid "File to write"
msgstr "Fichier à écrire"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/command.cpp
#: src/exe/cli/commands/split_file.cpp
msgid "Work out and say what would be written, and write nothing"
msgstr "Calculer et dire ce qui serait écrit, et ne rien écrire"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid "Put the subtitles in order of their start before writing"
msgstr "Mettre les sous-titres dans l'ordre de leur début avant d'écrire"

#: src/exe/cli/commands/append.cpp src/exe/cli/commands/convert.cpp
msgid ""
"Cut overlapping subtitles so that no range overlaps another, before writing"
msgstr ""
"Couper les sous-titres qui se chevauchent pour qu'aucune plage n'en "
"chevauche une autre, avant d'écrire"

#: src/exe/cli/commands/append.cpp
msgid "append needs a base file and at least one file to put after it"
msgstr ""
"append demande un fichier de base et au moins un fichier à mettre après lui"

#: src/exe/cli/commands/append.cpp
msgid "no destination given: append writes one file, use --output"
msgstr ""
"aucune destination donnée : append écrit un seul fichier, utilisez --output"

#: src/exe/cli/commands/command.cpp
msgid "File to write, for a single input"
msgstr "Fichier à écrire, pour une seule entrée"

#: src/exe/cli/commands/command.cpp
msgid "Directory to write into"
msgstr "Répertoire dans lequel écrire"

#: src/exe/cli/commands/command.cpp
msgid "Write back over the inputs"
msgstr "Écrire par-dessus les entrées"

#: src/exe/cli/commands/command.cpp
msgid "Take directories as inputs, and every subtitle file in them"
msgstr ""
"Prendre des répertoires en entrée, et tous les fichiers de sous-titres "
"qu'ils contiennent"

#: src/exe/cli/commands/command.cpp
msgid "Act only on subtitles N to M, or N to the end"
msgstr "N'agir que sur les sous-titres N à M, ou N jusqu'à la fin"

#: src/exe/cli/commands/command.cpp
msgid "Translation file to lay over the subtitle file, for a single input"
msgstr ""
"Fichier de traduction à superposer au fichier de sous-titres, pour une seule "
"entrée"

#: src/exe/cli/commands/command.cpp
msgid "How the lines of the translation find their subtitles"
msgstr "Comment les lignes de la traduction trouvent leurs sous-titres"

#: src/exe/cli/commands/command.cpp
msgid "The document to change: the main one, or the translation given by -t"
msgstr "Le document à modifier : le principal, ou la traduction donnée par -t"

#: src/exe/cli/commands/config.cpp
msgid "List, show and change the operation settings"
msgstr "Lister, afficher et modifier les réglages des opérations"

#: src/exe/cli/commands/config.cpp
msgid ""
"Write every operation key, what it is for, what it accepts and its default"
msgstr ""
"Écrire chaque clé d'opération, son rôle, ce qu'elle accepte et sa valeur par "
"défaut"

#: src/exe/cli/commands/config.cpp
msgid "Write the settings file used, then every operation key with its value"
msgstr ""
"Écrire le fichier de réglages utilisé, puis chaque clé d'opération avec sa "
"valeur"

