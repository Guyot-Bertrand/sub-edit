#: src/exe/cli/application.cpp
msgid "Display program version information and exit"
msgstr "Afficher la version du programme et quitter"

#: src/exe/cli/application.cpp
msgid "Say more: -v is the default, -vv details, -vvv debugs"
msgstr ""
"En dire plus : -v par défaut, -vv pour les détails, -vvv pour le débogage"

