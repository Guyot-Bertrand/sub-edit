msgstr "Forme du résultat sur la sortie standard : text ou json"

#: src/exe/cli/application.cpp
msgid ""
"Read the operation settings from FILE instead of the user's settings file"
msgstr ""
"Lire les réglages des opérations dans FILE au lieu du fichier de réglages de "
"l'utilisateur"

