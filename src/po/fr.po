#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Réglages de subedit.\n"
"#\n"
"# Les options laissées à leur valeur par défaut sont écrites en "
"commentaire.\n"
"# Décommentez une ligne et changez sa valeur pour la remplacer ; supprimez\n"
"# la ligne pour revenir à la valeur par défaut, quelle qu'elle devienne\n"
"# dans une version ultérieure.\n"
"#\n"
"# Deux d'entre elles valent par défaut ce que choisit la fenêtre plutôt\n"
"# qu'un nombre : leur ligne commentée montre la forme d'une valeur, et non\n"
"# une valeur par défaut en vigueur.\n"
"#\n"
"# Une valeur que ce fichier ne peut pas lire est laissée à sa valeur par\n"
"# défaut, et cela est dit sur la sortie d'erreur au démarrage du programme.\n"

#: src/lib/subedit/core/wording/settings.cpp
msgid "cannot be read, keeping the default"
msgstr "illisible, valeur par défaut conservée"

#: src/lib/subedit/core/wording/settings.cpp
msgid "settings could not be written"
msgstr "les réglages n'ont pas pu être écrits"

