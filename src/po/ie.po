#: src/lib/subedit/core/wording/settings.cpp
msgid ""
"# subedit settings.\n"
"#\n"
"# Options left at their default are written commented out. Uncomment a\n"
"# line and change its value to override it; delete the line to go back\n"
"# to the default, whatever that default becomes in a later version.\n"
"#\n"
"# Two of them default to whatever the window chooses rather than to a\n"
"# number: their commented line shows the shape of a value, not a\n"
"# default that is in force.\n"
"#\n"
"# A value this file cannot read is left at its default, and said so on\n"
"# the standard error when the program starts.\n"
msgstr ""
"# Parametres de subedit.\n"
"#\n"
"# Li optiones lassat a lor valore predefinit es scrit in comentarie. "
"Decomentar un\n"
"# linea e changear su valore por remplazzar it; remover li linea por "
"retornar\n"
"# al predefinit, quel que ti predefinit deveni in un version posterior.\n"
"#\n"
"# Du de les ha quam predefinit quo li fenestre selecte vice un\n"
"# númere: lor linea in comentarie monstra li forme de un valore, ne un\n"
"# predefinit in vigore.\n"
"#\n"
"# Un valore que ti file ne posse leer es lassat a su predefinit, e it es dit "
"sur\n"
"# li exit de errores quande li programma comensa.\n"

#: src/lib/subedit/core/wording/settings.cpp
msgid "cannot be read, keeping the default"
msgstr "ne posse esser leet, predefinit conservat"

#: src/lib/subedit/core/wording/settings.cpp
msgid "settings could not be written"
msgstr "li parametres ne posse esser scrit"

