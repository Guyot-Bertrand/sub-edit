# Reference repository cloned locally, never committed
reference/

# Working files.
src/data/

# The maintainer's scratch directory: working files that are never the project's.
src/tmp/

# IDE settings, specific to each machine
.idea/
.vscode/
*.swp

# Build artefacts
build/

# The bytecode Python leaves next to an imported script. The repository carries
# five Python scripts; it takes only a tool importing one for a __pycache__ to
# appear under src/scripts, where `check-architecture.sh` takes it for a
# non-executable script — it has happened.
__pycache__/
*.pyc

# The log and artefacts of a plan's execution by subagents
# (superpowers:subagent-driven-development): specific to a session, never to
# the repository.
.superpowers/
