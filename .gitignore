# Dépôt de référence cloné localement, jamais commité
reference/

# Fichiers de travail.
src/data/

# Réglages d'IDE, propres à chaque poste
.idea/
.vscode/
*.swp

# Artefacts de construction
build/

# Le bytecode que Python laisse à côté d'un script importé. Le dépôt porte cinq
# scripts Python ; il suffit qu'un outil en importe un pour qu'un __pycache__
# apparaisse sous src/scripts, où `check-architecture.sh` le prend pour un
# script non exécutable — c'est arrivé.
__pycache__/
*.pyc
