---
# The subedit project style. See docs/specs/00-fondations.md.
#
# Derived from LLVM, with three deviations: 4-space indentation, 100 columns
# and left-aligned pointers — the type carries the `*`, not the name.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BreakConstructorInitializers: BeforeColon
EmptyLineBeforeAccessModifier: Always
FixNamespaceComments: true
IndentPPDirectives: AfterHash
PackConstructorInitializers: NextLine
SeparateDefinitionBlocks: Always
SpaceAfterTemplateKeyword: false

# Include order: the header matching the file (priority 0, detected
# automatically), then project headers, then third-party libraries, then the
# standard library.
#
# Putting the project headers first is deliberate: a header that forgets one of
# its own includes then fails to compile, instead of being rescued by a <string>
# included higher up. The opposite order would hide the defect.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<subedit/'
    Priority: 1
  - Regex: '^<(catch2|Q|mpv/|unicode/)'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 4
