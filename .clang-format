---
# Style du projet subedit. Voir docs/specs/00-fondations.md.
#
# Dérivé de LLVM, avec trois écarts : indentation de 4 espaces, colonnes à 100
# et pointeurs alignés à gauche — le type porte le `*`, pas le nom.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BreakConstructorInitializers: BeforeColon
EmptyLineBeforeAccessModifier: Always
FixNamespaceComments: true
IndentPPDirectives: AfterHash
PackConstructorInitializers: NextLine
SeparateDefinitionBlocks: Always
SpaceAfterTemplateKeyword: false

# Les en-têtes du projet forment leur propre groupe, après ceux des
# bibliothèques : une inversion révèle un en-tête projet non autonome.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<subedit/'
    Priority: 3
  - Regex: '^<catch2/'
    Priority: 2
  - Regex: '^<Q'
    Priority: 2
  - Regex: '^<'
    Priority: 1
  - Regex: '.*'
    Priority: 4
