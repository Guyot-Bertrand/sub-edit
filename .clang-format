---
# Style du projet subedit. Voir docs/specs/00-fondations.md.
#
# Dérivé de LLVM, avec trois écarts : indentation de 4 espaces, colonnes à 100
# et pointeurs alignés à gauche — le type porte le `*`, pas le nom.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BreakConstructorInitializers: BeforeColon
EmptyLineBeforeAccessModifier: Always
FixNamespaceComments: true
IndentPPDirectives: AfterHash
PackConstructorInitializers: NextLine
SeparateDefinitionBlocks: Always
SpaceAfterTemplateKeyword: false

# Ordre des inclusions : en-tête correspondant au fichier (priorité 0, détecté
# automatiquement), puis en-têtes du projet, puis bibliothèques tierces, puis
# bibliothèque standard.
#
# Placer les en-têtes du projet en premier est délibéré : un en-tête qui oublie
# une de ses propres inclusions échoue alors à compiler, au lieu d'être sauvé
# par un <string> inclus plus haut. L'ordre inverse masquerait le défaut.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<subedit/'
    Priority: 1
  - Regex: '^<(catch2|Q|mpv/|unicode/)'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 4
